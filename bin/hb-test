#######################################
# FT-18: 4K → 1080p downscale (HDR preserved)
#######################################

test_downscale_hdr() {
    local in="$INPUT/hevc_hdr10.mkv"
    local out="$OUTPUT/ft18_downscale_1080p.mkv"
    local probe

    assert_file "$in" || return 1

    if ! run_encode -i "$in" -o "$out" \
        -e x265_10bit --encoder-profile main10 \
        --width 1920 --height 1080 --crop 0:0:0:0 \
        --audio 1 --aencoder copy --subtitle none; then
        fail "FT-18: encoder crashed or returned non-zero exit code"
        return 1
    fi

    assert_file "$out" || return 1

    probe=$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=width,height,pix_fmt,color_primaries,color_transfer \
        -of json "$out")

    if ! echo "$probe" | jq -e '
        .streams[0].width==1920 and
        .streams[0].height==1080 and
        .streams[0].pix_fmt=="yuv420p10le" and
        .streams[0].color_primaries=="bt2020" and
        .streams[0].color_transfer=="smpte2084"
    ' >/dev/null; then
        echo "Actual stream metadata:"
        echo "$probe" | jq '.streams[0]'
        fail "FT-18: Downscale wrong geometry or HDR metadata lost"
        return 1
    fi

    pass
}

#######################################
# FT-19: HDR → SDR tone mapping
#######################################

test_tonemap_sdr() {
    local in="$INPUT/hevc_hdr10.mkv"
    local out="$OUTPUT/ft19_tonemap_sdr.mkv"
    local probe

    assert_file "$in" || return 1

    if ! run_encode -i "$in" -o "$out" \
        -e x264 --colorspace bt709 \
        --audio 1 --aencoder copy --subtitle none; then
        fail "FT-19: encoder crashed or returned non-zero exit code"
        return 1
    fi

    assert_file "$out" || return 1

    probe=$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=pix_fmt,color_primaries,color_transfer \
        -of json "$out")

    if ! echo "$probe" | jq -e '
        .streams[0].pix_fmt=="yuv420p" and
        .streams[0].color_primaries=="bt709" and
        .streams[0].color_transfer=="bt709"
    ' >/dev/null; then
        echo "Actual stream metadata:"
        echo "$probe" | jq '.streams[0]'
        fail "FT-19: HDR input not tone-mapped to BT.709 SDR"
        return 1
    fi

    pass
}

#######################################
# FT-20: Clip extraction (--start-at/--stop-at)
#######################################

test_clip_extract() {
    local in="$INPUT/sdr_1080p.mp4"
    local out="$OUTPUT/ft20_clip.mp4"
    local probe

    assert_file "$in" || return 1

    # --stop-at is a DURATION relative to --start-at → expect a ~3 s clip
    if ! run_encode -i "$in" -o "$out" \
        -e x264 --encoder-preset veryfast --format mp4 \
        --start-at seconds:1 --stop-at seconds:3 \
        --audio 1 --aencoder copy --subtitle none; then
        fail "FT-20: encoder crashed or returned non-zero exit code"
        return 1
    fi

    assert_file "$out" || return 1

    probe=$(ffprobe -v error -show_entries format=duration -of json "$out")

    if ! echo "$probe" | jq -e '
        (.format.duration|tonumber) >= 2.5 and
        (.format.duration|tonumber) <= 3.5
    ' >/dev/null; then
        echo "Actual container duration:"
        echo "$probe" | jq '.format.duration'
        fail "FT-20: clip duration outside expected 3 s ± 0.5 s window"
        return 1
    fi

    pass
}

#######################################
# FT-21: VFR → CFR conversion
#######################################

test_cfr_conversion() {
    local in="$INPUT/sdr_1080p.mp4"
    local out="$OUTPUT/ft21_cfr.mp4"
    local probe

    assert_file "$in" || return 1

    if ! run_encode -i "$in" -o "$out" \
        -e x264 --encoder-preset veryfast --format mp4 \
        --cfr --rate 30 \
        --audio 1 --aencoder copy --subtitle none; then
        fail "FT-21: encoder crashed or returned non-zero exit code"
        return 1
    fi

    assert_file "$out" || return 1

    probe=$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=codec_name,r_frame_rate,avg_frame_rate \
        -of json "$out")

    if ! echo "$probe" | jq -e '
        .streams[0].avg_frame_rate=="30/1" and
        .streams[0].r_frame_rate=="30/1"
    ' >/dev/null; then
        echo "Actual stream metadata:"
        echo "$probe" | jq '.streams[0]'
        fail "FT-21: output is not constant 30 fps"
        return 1
    fi

    pass
}

#######################################
# FT-22: Invalid input (negative test)
#######################################

test_invalid_input() {
    local in="$OUTPUT/ft22_garbage_input.mp4"
    local out="$OUTPUT/ft22_garbage_out.mkv"

    # 64 KiB of zero bytes – deterministic non-media data
    if ! dd if=/dev/zero of="$in" bs=1024 count=64 2>/dev/null; then
        fail "FT-22: could not create garbage input file"
        return 1
    fi

    # The encoder must reject this loudly (non-zero exit) …
    if run_encode -i "$in" -o "$out" \
        -e x264 --audio none --subtitle none; then
        fail "FT-22: encoder accepted invalid input (exit code 0)"
        return 1
    fi

    # … and must not leave a non-empty output file behind
    if [[ -s "$out" ]]; then
        fail "FT-22: encoder produced output from invalid input"
        return 1
    fi

    pass
}

#######################################
# FT-23: Visual fidelity (SSIM vs source)
#######################################

test_visual_fidelity() {
    local in="$INPUT/sdr_1080p.mp4"
    local out="$OUTPUT/ft23_ssim.mkv"
    local ssim

    # ffmpeg ships with the same Homebrew formula as ffprobe, but is not a
    # hard requirement of the suite – skip gracefully if absent
    if ! command -v ffmpeg >/dev/null 2>&1; then
        skip "ffmpeg not available for SSIM comparison"
        return
    fi

    assert_file "$in" || return 1

    # No crop/scale so the SSIM filter compares identical geometries
    if ! run_encode -i "$in" -o "$out" \
        -e x264 -q 18 --encoder-preset veryfast \
        --crop 0:0:0:0 \
        --audio none --subtitle none; then
        fail "FT-23: encoder crashed or returned non-zero exit code"
        return 1
    fi

    assert_file "$out" || return 1

    # ssim filter logs "... All:0.987654 ..." at info level on stderr
    ssim=$(ffmpeg -nostdin -i "$out" -i "$in" -lavfi ssim -an -f null - 2>&1 \
        | sed -nE 's/.*All:([0-9.]+).*/\1/p' | tail -n 1)

    if [[ -z "$ssim" ]]; then
        fail "FT-23: could not compute SSIM"
        return 1
    fi

    # Catches green/black-frame, color-shift and stride bugs that pure
    # metadata checks cannot see (zsh arithmetic handles floats)
    if ! (( ssim >= 0.85 )); then
        fail "FT-23: SSIM too low ($ssim) – output visually diverges from source"
        return 1
    fi

    pass
}

#######################################
# Main
#######################################

main() {
    print "======================================"
    print " HandBrake Functional Test Suite (zsh)"
    print "======================================"

    validate_inputs
    validate_env

    run_test "FT-01 H.264 SDR"          test_h264_sdr
    run_test "FT-02 HEVC SDR"           test_hevc_sdr
    run_test "FT-03 HEVC HDR10"         test_hevc_hdr10
    run_test "FT-04 AV1 SDR"            test_av1_sdr
    run_test "FT-05 AV1 HDR10 4K"       test_av1_hdr10_4k
    run_test "FT-06 Audio Downmix"      test_audio_downmix
    run_test "FT-07 Subtitles"          test_subtitles
    run_test "FT-08 HEVC HDR10+"        test_hevc_hdr10plus
    run_test "FT-09 Dolby Vision"       test_dolby_vision
    run_test "FT-10 MPEG-2"             test_mpeg2_sdr
    run_test "FT-11 MPEG-4"             test_mpeg4
    run_test "FT-12 FFV1"               test_ffv1
    run_test "FT-13 H.264 VT"           test_h264_vt
    run_test "FT-14 H.265 VT"           test_h265_vt
    run_test "FT-15 H.265 VT 10-bit"    test_h265_vt_10bit
    run_test "FT-16 VP9"                test_vp9_mp4
    run_test "FT-17 Theora"             test_theora
    run_test "FT-18 Downscale HDR"      test_downscale_hdr
    run_test "FT-19 Tonemap SDR"        test_tonemap_sdr
    run_test "FT-20 Clip Extract"       test_clip_extract
    run_test "FT-21 CFR Convert"        test_cfr_conversion
    run_test "FT-22 Invalid Input"      test_invalid_input
    run_test "FT-23 Visual SSIM"        test_visual_fidelity

    print "\n======================================"
print " TEST SUMMARY"
print "======================================"

local failed=0

for t in "${TEST_ORDER[@]}"; do
    # Show the recorded failure/skip reason next to the result
    printf "%-25s : %s%s\n" "$t" "${TEST_RESULTS[$t]}" \
        "${TEST_MESSAGES[$t]:+ – ${TEST_MESSAGES[$t]}}"
    [[ "${TEST_RESULTS[$t]}" == "FAIL" ]] && failed=1
done

print "======================================"

if [[ $failed -eq 0 ]]; then
    print "✔ ALL TESTS PASSED"
    # Security: clean up .stderr files on success to avoid information leakage
    rm -f "$OUTPUT"/*.stderr(N)
else
    print "❌ SOME TESTS FAILED"
    print "ℹ️  Encoder stderr logs retained in $OUTPUT for diagnosis"
fi

return $failed
    }

main "$@"