        ' >/dev/null; then
        fail "FT-17: Theora encode failed"
        return 1
    fi

    pass
}

#######################################
# Main
#######################################

main() {
    print "======================================"
    print " HandBrake Functional Test Suite (zsh)"
    print "======================================"

    validate_inputs
    validate_env

    run_test "FT-01 H.264 SDR"          test_h264_sdr
    run_test "FT-02 HEVC SDR"           test_hevc_sdr
    run_test "FT-03 HEVC HDR10"         test_hevc_hdr10
    run_test "FT-04 AV1 SDR"            test_av1_sdr
    run_test "FT-05 AV1 HDR10 4K"       test_av1_hdr10_4k
    run_test "FT-06 Audio Downmix"      test_audio_downmix
    run_test "FT-07 Subtitles"          test_subtitles
    run_test "FT-08 HEVC HDR10+"        test_hevc_hdr10plus
    run_test "FT-09 Dolby Vision"       test_dolby_vision
    run_test "FT-10 MPEG-2"             test_mpeg2_sdr
    run_test "FT-11 MPEG-4"             test_mpeg4
    run_test "FT-12 FFV1"               test_ffv1
    run_test "FT-13 H.264 VT"           test_h264_vt
    run_test "FT-14 H.265 VT"           test_h265_vt
    run_test "FT-15 H.265 VT 10-bit"    test_h265_vt_10bit
    run_test "FT-16 VP9"                test_vp9_mp4
    run_test "FT-17 Theora"             test_theora

    print "\n======================================"
print " TEST SUMMARY"
print "======================================"

local failed=0

for t in "${TEST_ORDER[@]}"; do
    printf "%-25s : %s\n" "$t" "${TEST_RESULTS[$t]}"
    [[ "${TEST_RESULTS[$t]}" == "FAIL" ]] && failed=1
done

print "======================================"

if [[ $failed -eq 0 ]]; then
    print "✔ ALL TESTS PASSED"
    # Security: clean up .stderr files on success to avoid information leakage
    rm -f "$OUTPUT"/*.stderr(N)
else
    print "❌ SOME TESTS FAILED"
    print "ℹ️  Encoder stderr logs retained in $OUTPUT for diagnosis"
fi

return $failed
    }

main "$@"