    local out="$OUTPUT/ft12_ffv1.mkv"

    assert_file "$in"

    if ! run_encode -i "$in" -o "$out" \
        -e ffv1 --format mkv --encoder-level 3 \
        --audio 1 --aencoder copy --subtitle none; then
        fail "FT-12: encoder crashed or returned non-zero exit code"
        return 1
    fi
    
    assert_file "$out"

    if [[ ! -f "$out" || ! -s "$out" ]]; then
        fail "FT-12: Output file not created"
        return 1
    fi

    if ! ffprobe -v error -select_streams v:0 \
        -show_entries stream=codec_name \
        -of json "$out" | jq -e '.streams[0].codec_name=="ffv1"' >/dev/null; then
