    fi

    pass
}

#######################################
# FT-13: H.264 Videotoolbox
#######################################

test_h264_vt() {
    local in="$INPUT/sdr_1080p.mp4"
    local out="$OUTPUT/ft13_h264_vt.mp4"
    local probe
    
    assert_file "$in"

    if ! run_encode -i "$in" -o "$out" \
        -e vt_h264 --format mp4 \
        --audio 1 --aencoder copy --subtitle none; then
        fail "FT-13: encoder crashed or returned non-zero exit code"
        return 1
    fi

    assert_file "$out"
    
    if [[ ! -f "$out" || ! -s "$out" ]]; then
        fail "Output file not created"
        return 1
    fi
    
    probe=$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=codec_name,pix_fmt,color_transfer \
        -of json "$out")
        
    if ! echo "$probe" | jq -e '
        .streams[0].codec_name=="h264" and
        .streams[0].pix_fmt=="yuv420p" and
        (.streams[0].color_transfer==null or .streams[0].color_transfer=="bt709")
    ' >/dev/null; then
        echo "Actual stream metadata:"
        echo "$probe" | jq '.streams[0]'
        fail "FT-13: Invalid H.264 SDR stream"
        return 1
    fi
  
    pass
}

