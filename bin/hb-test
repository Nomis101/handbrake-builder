#######################################
# FT-17: Theora (MKV)
#######################################

test_theora() {
    local in="$INPUT/sdr_1080p.mp4" 
    local out="$OUTPUT/ft17_theora.mkv"
    
    assert_file "$in"

    if ! run_encode -i "$in" -o "$out" \
        -e theora --format mkv \
        --audio none --subtitle none; then
        fail "FT-17: encoder crashed or returned non-zero exit code"
        return 1
    fi

