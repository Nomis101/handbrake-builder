#######################################
# FT-05: AV1 4K HDR10
#######################################

test_av1_hdr10_4k() {
    local in="$INPUT/hevc_hdr10.mkv"
    local out="$OUTPUT/ft05_av1_hdr10_4k.mkv"
    
    assert_file "$in"

    if ! run_encode -i "$in" -o "$out" \
        -e svt_av1_10bit --encoder-preset 10 \
        --audio 1 --aencoder copy \
        --subtitle none; then
        fail "FT-05: encoder crashed or returned non-zero exit code"
        return 1
    fi

    assert_file "$out"
    
    if [[ ! -f "$out" || ! -s "$out" ]]; then
        fail "Output file not created"
        return 1
    fi

    if ! ffprobe -v error -select_streams v:0 \
        -show_entries stream=codec_name,pix_fmt,color_primaries,color_transfer,width,height \
        -of json "$out" | jq -e '
            .streams[0].codec_name=="av1" and
            .streams[0].pix_fmt=="yuv420p10le" and
            .streams[0].color_primaries=="bt2020" and
            .streams[0].color_transfer=="smpte2084" and
            .streams[0].width>=3840
        ' >/dev/null; then
        fail "FT-05: Invalid AV1 4K HDR10 stream"
        return 1
    fi

    pass
}

#######################################
# FT-06: Audio Downmix
#######################################

test_audio_downmix() {
    local in="$INPUT/audio_5.1.mkv"
    local out="$OUTPUT/ft06_audio_downmix.mkv"
    
    assert_file "$in"

    if ! run_encode -i "$in" -o "$out" \
        --audio 1 --aencoder aac --mixdown stereo \
        --subtitle none; then
        fail "FT-06: encoder crashed or returned non-zero exit code"
        return 1
    fi

    assert_file "$out"
    
    if [[ ! -f "$out" || ! -s "$out" ]]; then
        fail "Output file not created"
        return 1
    fi

    if ! ffprobe -v error -select_streams a:0 \
        -show_entries stream=channels \
        -of json "$out" | jq -e '
            .streams[0].channels==2
        ' >/dev/null; then
        fail "FT-06: Audio not downmixed"
        return 1
    fi

    pass
}

#######################################
# FT-07: Subtitle Passthrough
#######################################

test_subtitles() {
    local in="$INPUT/ft07_subs.mkv"
    local out="$OUTPUT/ft07_subs_out.mkv"
    
    assert_file "$in"

    if ! run_encode -i "$in" -o "$out" \
        --subtitle 1 --subtitle-burned=none \
        --audio 1 --aencoder copy; then
        fail "FT-07: encoder crashed or returned non-zero exit code"
        return 1
    fi

    assert_file "$out"
    
    if [[ ! -f "$out" || ! -s "$out" ]]; then
        fail "Output file not created"
        return 1
    fi

    if ! ffprobe -v error -select_streams s \
        -show_entries stream=index \
        -of json "$out" | jq -e '
            .streams | length > 0
        ' >/dev/null; then
        fail "FT-07: Subtitle missing"
        return 1
    fi

    pass
}

#######################################
# FT-08: HEVC HDR10+ (dynamic metadata)
#######################################

test_hevc_hdr10plus() {
    local in="$INPUT/hdr10plus_4k.mp4"
    local out="$OUTPUT/ft08_hevc_hdr10plus.mkv"

    assert_file "$in"

    if ! run_encode -i "$in" -o "$out" \
        -e x265_10bit --encoder-profile main10 --format mkv \
        --hdr-dynamic-metadata hdr10plus \
        --audio 1 --aencoder copy --subtitle none; then
        fail "FT-08: encoder crashed or returned non-zero exit code"
        return 1
    fi

    assert_file "$out"
    
    if [[ ! -f "$out" || ! -s "$out" ]]; then
        fail "Output file not created"
        return 1
    fi

    local hdr
    hdr=$(mediainfo --Output=JSON "$out" | jq -r '
        .media.track[]
        | select(."@type"=="Video")
        | (.HDR_Format // "") + " " + (.HDR_Format_Compatibility // "")
    ')

    if [[ "$hdr" != *"ST 2094 App 4"* ]]; then
        echo "Actual HDR metadata: $hdr"
        fail "FT-08: HDR10+ metadata missing (SMPTE ST 2094 App 4 not found)"
        return 1
    fi

    pass
}

#######################################
# FT-09: Dolby Vision
#######################################

test_dolby_vision() {
    local in="$INPUT/dolby_vision_1080p.mkv"
    local out="$OUTPUT/ft09_dolby_vision.mkv"

    assert_file "$in"

    mediainfo "$in" | grep -qi "dolby vision" || {
        skip "Input has no Dolby Vision metadata"
        return
    }

    if ! run_encode -i "$in" -o "$out" \
        -e x265_10bit --encoder-profile main10 \
        --hdr-dynamic-metadata dolbyvision \
        --audio 1 --aencoder copy --subtitle none; then
        fail "FT-09: encoder crashed or returned non-zero exit code"
        return 1
    fi

    assert_file "$out"
    
    if [[ ! -f "$out" || ! -s "$out" ]]; then
        fail "Output file not created"
        return 1
    fi

    local dv
    dv=$(mediainfo --Output=JSON "$out" | jq -r '
        .media.track[]
        | select(."@type"=="Video")
        | (
            .HDR_Format // "" + " " +
            .HDR_Format_Profile // "" + " " +
            .HDR_Format_Compatibility // ""
        )
    ')

    if [[ "$dv" != *"dv"* ]] && [[ "$dv" != *"Dolby Vision"* ]]; then
        echo "Actual HDR metadata: $dv"
        fail "FT-09: Dolby Vision metadata missing"
        return 1
    fi

    pass
}

