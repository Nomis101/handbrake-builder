#!/usr/bin/env zsh
set -euo pipefail
IFS=$'\n\t'
umask 077

# Security: sanitize PATH to prevent execution of attacker-planted binaries
PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin"

#######################################
# Functional Test Input Assets
#
# All files must be SHORT (5–15 seconds),
# visually simple, and deterministic.
#
# Directory layout:
#   $TEST_DIR/inputs/
#######################################

# --- REQUIRED INPUT FILES ---

# sdr_1080p.mp4
# 1920x1080 | SDR | BT.709 | yuv420p | H.264 video | AAC audio
#
# hevc_hdr10.mkv
# 3840x2160 | HDR10 | BT.2020 | PQ | 10-bit | HEVC | static metadata
#
# hdr10plus_4k.mp4
# 3840x2160 | HDR10+ | BT.2020 | PQ | dynamic metadata (SMPTE 2094-40)
#
# dolby_vision_1080p.mkv
# 1920x1080 | Dolby Vision | Profile 5 or 8.1 | RPU metadata present
#
# audio_5.1.mkv
# 1920x1080 | SDR | 5.1 discrete audio | AAC / FLAC | channel-test content
#
# ft07_subs.mkv
# 1920x1080 | SDR | text subtitles (SRT/SSA) | known visible cues
#######################################


#######################################
# Paths
#######################################

ROOT="$HOME/Library/Application Support/HandBrakeBuilder"
TEST_DIR="$ROOT/tests"
INPUT="$TEST_DIR/inputs"
OUTPUT="$TEST_DIR/outputs"

# Security: create directories then verify they are not symlinks (post-creation check)
for _dir in "$TEST_DIR" "$INPUT" "$OUTPUT"; do
    if [[ -L "$_dir" ]]; then
        print "❌ Directory path is a symlink (possible attack): $_dir"
        exit 1
    fi
    mkdir -p "$_dir"
    chmod 0700 "$_dir"
    if [[ -L "$_dir" ]]; then
        print "❌ Directory became a symlink after creation (race detected): $_dir"
        exit 1
    fi
done

#######################################
# Framework and Helper
#######################################

current_test=""

fail() {
    TEST_RESULTS[$current_test]="FAIL"
    TEST_MESSAGES[$current_test]="$1"
    print "❌ FAIL: $1"
    return 1
}

pass() {
    TEST_RESULTS[$current_test]="PASS"
    return 0
}

skip() {
    TEST_RESULTS[$current_test]="SKIP"
    TEST_MESSAGES[$current_test]="$1"
    print "⚠ SKIP: $1"
    return 0
}

require() {
    command -v "$1" >/dev/null 2>&1 || fail "Missing tool: $1"
}

# Security: capture encoder stderr to per-test log files instead of discarding
run_encode() {
    local _stderr_log="${out:r}.stderr"
    HandBrakeCLI "$@" >/dev/null 2>"$_stderr_log"
}

assert_file() {
    [[ -f "$1" ]] || fail "Missing file: $1"
    [[ -s "$1" ]] || fail "Empty file: $1"
}

run_test() {
    local test_id="$1"
    shift

    TEST_ORDER+=("$test_id")
    current_test="$test_id"

    print "▶ $test_id"

   if "$@"; then
        # Prüfe nochmal, ob die TEST_RESULTS von der Funktion gesetzt wurde
        [[ -z "${TEST_RESULTS[$test_id]}" ]] && TEST_RESULTS[$test_id]="PASS"
    else
        [[ -z "${TEST_RESULTS[$test_id]}" ]] && TEST_RESULTS[$test_id]="FAIL"
    fi
}

#######################################
# Tracking
#######################################

typeset -A TEST_RESULTS
typeset -A TEST_MESSAGES
typeset -a TEST_ORDER

#######################################
# Environment check
#######################################

validate_env() {
    for t in HandBrakeCLI ffprobe jq mediainfo; do
        require "$t"
    done

    # Security: verify OUTPUT is not a symlink before AND after creation
    if [[ -L "$OUTPUT" ]]; then
        fail "Output directory is a symlink: $OUTPUT"
        return 1
    fi
    mkdir -p "$OUTPUT"
    if [[ -L "$OUTPUT" ]]; then
        fail "Output directory became a symlink (race detected): $OUTPUT"
        return 1
    fi
    rm -f "$OUTPUT"/*(N)
}

#######################################
# Validate inputs
#######################################

validate_inputs() {
    local files=(
        sdr_1080p.mp4
        hevc_hdr10.mkv
        hdr10plus_4k.mp4
        dolby_vision_1080p.mkv
        audio_5.1.mkv
        ft07_subs.mkv
    )

    for f in $files; do
        assert_file "$INPUT/$f"
    done
}

#######################################
# FT-01: H.264 SDR
#######################################

test_h264_sdr() {
    local in="$INPUT/sdr_1080p.mp4"
    local out="$OUTPUT/ft01_h264_sdr.mkv"
    local probe

    assert_file "$in"

    if ! run_encode -i "$in" -o "$out" \
        -e x264 --encoder-preset veryfast \
        --audio 1 --aencoder copy \
        --subtitle none; then
        fail "FT-01: encoder crashed or returned non-zero exit code"
        return 1
    fi

    assert_file "$out"

    if [[ ! -f "$out" || ! -s "$out" ]]; then
        fail "Output file not created"
        return 1
    fi
    
    probe=$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=codec_name,pix_fmt,color_transfer \
        -of json "$out")

    if ! echo "$probe" | jq -e '
        .streams[0].codec_name=="h264" and
        .streams[0].pix_fmt=="yuv420p" and
        (.streams[0].color_transfer==null or .streams[0].color_transfer=="bt709")
    ' >/dev/null; then
        echo "Actual stream metadata:"
        echo "$probe" | jq '.streams[0]'
        fail "FT-01: Invalid H.264 SDR stream"
        return 1
    fi

    pass
}

#######################################
# FT-02: HEVC SDR
#######################################

test_hevc_sdr() {
    local in="$INPUT/sdr_1080p.mp4"
    local out="$OUTPUT/ft02_hevc_sdr.mkv"
    
    assert_file "$in"

    if ! run_encode -i "$in" -o "$out" \
        -e x265 --encoder-profile main \
        --audio 1 --aencoder copy \
        --subtitle none; then
        fail "FT-02: encoder crashed or returned non-zero exit code"
        return 1
    fi

    assert_file "$out"
    
    if [[ ! -f "$out" || ! -s "$out" ]]; then
        fail "Output file not created"
        return 1
    fi

    if ! ffprobe -v error -select_streams v:0 \
        -show_entries stream=codec_name,pix_fmt \
        -of json "$out" | jq -e '
            .streams[0].codec_name=="hevc" and
            .streams[0].pix_fmt=="yuv420p"
        ' >/dev/null; then
        fail "FT-02: Invalid HEVC SDR stream"
        return 1
    fi

    pass
}

#######################################
# FT-03: HEVC HDR10 (baseline)
#######################################

test_hevc_hdr10() {
    local in="$INPUT/hevc_hdr10.mkv"
    local out="$OUTPUT/ft03_ahevc_hdr10.mkv"
    
    assert_file "$in"

    if ! run_encode -i "$in" -o "$out" \
       -e x265 --encoder-profile main10 \
       --audio 1 --aencoder copy --subtitle none; then
       fail "FT-03: encoder crashed or returned non-zero exit code"
       return 1
    fi

    assert_file "$out"
    
    if [[ ! -f "$out" || ! -s "$out" ]]; then
        fail "Output file not created"
        return 1
    fi

    if ! ffprobe -v error -select_streams v:0 \
        -show_entries stream=pix_fmt,color_primaries,color_transfer \
        -of json "$out" | jq -e '
            .streams[0].pix_fmt=="yuv420p" and
            .streams[0].color_primaries=="bt2020" and
            .streams[0].color_transfer=="smpte2084"
        ' >/dev/null; then
        fail "FT-03: Invalid HDR10 stream"
        return 1
    fi

    pass
}

