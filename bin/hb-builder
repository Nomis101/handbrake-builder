#!/usr/bin/env zsh
#
# hb-builder — HandBrake macOS build & notarization helper
#
# Copyright (c) 2026, Nomis101
# All rights reserved.
#
# This source code is licensed under the BSD-style license found in the
# LICENSE file in the root directory of this source tree. 
#
# Requires:
#   - macOS 12+
#   - Xcode Command Line Tools
#   - Homebrew
#

set -euo pipefail
IFS=$'\n\t'
setopt EXTENDED_GLOB

#######################################
# Location for buildconfig.conf file
#######################################

CONFIG_DIR="$HOME/Library/Application Support/HandBrakeBuilder"
CONFIG_FILE="$CONFIG_DIR/buildconfig.conf"

#######################################
# Environment validation
#######################################

validate_environment() {
    echo "▶ Validating build environment"

    # --- macOS version ---
    local macos_major
    macos_major=$(sw_vers -productVersion | awk -F. '{print $1}')

    if (( macos_major < 12 )); then
        fail 1 $LINENO "macOS 12 or newer is required"
    fi

    # --- Xcode Command Line Tools ---
    if ! xcode-select -p >/dev/null 2>&1; then
        fail 1 $LINENO "Xcode Command Line Tools are not installed"
    fi

    # --- Required tools ---
    local required_tools=(
        git
        clang
        make
        xcrun
        codesign
    )

    for tool in "${required_tools[@]}"; do
        has_command "$tool" || fail 1 $LINENO "Required tool not found: $tool"
    done

    # --- Notarization tools (conditional) ---
    if [[ "$NOTARY_ENABLE" == "1" ]]; then
        xcrun notarytool help >/dev/null 2>&1 \
            || fail 1 $LINENO "notarytool not available (Xcode 13+ required)"
    fi

    # --- Disk space ---
    local avail_kb required_kb
    avail_kb=$(df -Pk "$DEV_DIR" | awk 'NR==2 {print $4}')
    required_kb=$((30 * 1024 * 1024)) # 30 GB

    if (( avail_kb < required_kb )); then
        fail 1 $LINENO "Insufficient disk space in DEV_DIR (need ≥ 30 GB)"
    fi

    echo "✔ Environment validation passed"
}

#######################################
# Collect build errors
#######################################

collect_errors() {
    if [[ "$ERROR_LOG" != "1" ]]; then
        return
    fi

    mkdir -p "$LOGDIR"
    : > "$ERRORLOG"

    sed -E 's/\x1B\[[0-9;]*[mK]//g' "$LOGFILE" 2>/dev/null \
    | awk '
    BEGIN {
        IGNORECASE = 1
        err = 0
        done = 0
    }

    # ---- primary error trigger ----
    !done && /(^|[[:space:]])(fatal error:|error:|syntaxerror|internal inconsistency error|build interrupted)/ {
        err = 1
        done = 1
        sub(/^[[:space:]]*/, "  : ")
        print
        next
    }

    # ---- allowed continuation lines ----
    err && /included from/ {
        sub(/^[[:space:]]*/, "  : ")
        print
        next
    }
    err && /^[[:space:]]*\|/ {
        sub(/^[[:space:]]*/, "  : ")
        print
        next
    }
    err && /^[[:space:]]*\^/ {
        sub(/^[[:space:]]*/, "  : ")
        print
        next
    }
    err && /^[[:space:]]*[0-9]+ error generated/ {
        sub(/^[[:space:]]*/, "  : ")
        print
        next
    }
    err && /make(\[[0-9]+\])?: \*\*\*/ {
        sub(/^[[:space:]]*/, "  : ")
        print
        next
    }
    err && /\*\* BUILD INTERRUPTED \*\*/ {
        sub(/^[[:space:]]*/, "  : ")
        print
        next
    }

    # ---- hard stop conditions (NO GROUPING!) ----
    err && /^\/usr\/bin\/gcc/   { err = 0; next }
    err && /^\/usr\/bin\/clang/ { err = 0; next }
    err && /^[[:space:]]*cd[[:space:]]/ { err = 0; next }
    err && /^[[:space:]]*builtin-/ { err = 0; next }
    err && /^[[:space:]]*ProcessXCFramework/ { err = 0; next }
    err && /^[[:space:]]*Command ExternalBuildToolExecution/ { err = 0; next }

    ' >> "$ERRORLOG"

    [[ -s "$ERRORLOG" ]] || rm -f "$ERRORLOG"
}

#######################################
# Support Functions
#######################################

fail() {
    local exit_code="${1:-1}"
    local line="${2:-unknown}"
    local cmd="${3:-<no command>}"
    
    collect_errors

    command -v afplay >/dev/null && afplay /System/Library/Sounds/Funk.aiff || true
    command -v terminal-notifier >/dev/null && /Applications/terminal-notifier.app/Contents/MacOS/terminal-notifier \
        -title "HandBrake" \
        -message "$(date '+%d-%m-%Y %H:%M'): Build failed (Exit $exit_code, Line $line)" || true

    echo "❌  Build failed"
    echo "   Exit code : $exit_code"
    echo "   Line      : $line"
    echo "   Command   : $cmd"
    
    if [[ -s "$ERRORLOG" ]]; then
        echo "❌  Error log written:"
        echo "   → $ERRORLOG"
        open -R "$ERRORLOG"
    fi

    exit "$exit_code"
}

trap '[[ $? -ne 0 ]] && fail $? $LINENO "${ZSH_DEBUG_CMD:-<no command>}"' ERR

has_command() {
    command -v "$1" >/dev/null 2>&1
}

check_command() {
    has_command "$1" || fail 1 $LINENO "Required command not found: $1"
}

log_intro() {
    echo "========================================"
    echo "HandBrake build started"
    echo "Time: $(date)"
    echo "Host: $(hostname)"
    echo "========================================"
}

log_build_metadata() {
    echo "----------------------------------------"
    echo "Build metadata"
    echo "Git commit  : $(git rev-parse --short HEAD 2>/dev/null || echo n/a)"
    echo "Git branch  : $(git branch --show-current 2>/dev/null || echo n/a)"
    echo "Git state   : $(git symbolic-ref --short HEAD 2>/dev/null || echo DETACHED)"
    echo "Compiler    : $(clang --version | head -n 1)"
    echo "macOS       : $(sw_vers -productVersion)"
    echo "Git ref     : ${HB_GIT_REF}"
    echo "Arch        : $(uname -m)"
    echo "SDK         : $(xcrun --show-sdk-version)"
    echo "Notary      : ${NOTARY_ENABLE:-0}"
    echo "Deps update : ${UPDATE_DEPS:-}"
    echo "Auto pull   : ${AUTO_GIT_PULL:-}"
    echo "Add config  : ${ADD_CONFIG_OPTS:-}"
    echo "Log warnings: ${WARN_LOG:-}"
    echo "Warn level  : ${WARN_LEVEL:-}"
    echo "----------------------------------------"
}
log_intro

#######################################
# Load configuration file
#######################################

load_config() {
    # Does file exist
    if [[ -f "$CONFIG_FILE" ]]; then
        echo "✔ Configuration file found – loading"
        source "$CONFIG_FILE"
    else
        echo "ℹ️  No configuration file found:"
        echo "   $CONFIG_FILE"
        read "answer?Create a configuration file from template? [Yes/No]: "

        case "$answer" in
            Yes|yes|Y|y)
                echo "Creating configuration file"
                mkdir -p "$CONFIG_DIR"
                
                # Check DEV_DIR
                if [[ -z "$DEV_DIR" ]]; then
                    DEV_DIR="$HOME//Documents"
                    echo "⚠️  DEV_DIR was empty – setting to $DEV_DIR"
                fi

                # Write template to DEV_DIR
                cat <<'EOF' > "$CONFIG_FILE"
# ============================================================
# HandBrake Builder – buildconfig.conf
#
# This file controls how the HandBrake build script behaves.
# All values are optional. If a value is empty, a sensible
# default will be used by the build script.
#
# The file is sourced by zsh – keep valid shell syntax!
# ============================================================


# Absolute path to your development directory.
# Examples:
#   DEV_DIR="$HOME/Developer"
#   DEV_DIR="/Volumes/Developer"
DEV_DIR="$HOME/Documents"

# Git reference to build
# Valid values:
#   - master (default)
#   - release tags, e.g. 1.10.2
#   - latest (highest semantic version tag)
HB_GIT_REF="master"

# Log generation
# Enable (1) or disable (0) collection of compiler log
# into a lof file
ENABLE_LOG=1

# Warning log generation
# Enable (1) or disable (0) collection of compiler warnings
# into a separate warnings log file.
WARN_LOG=

# Compiler warning verbosity (set from 0 to 2)
# Higher levels can generate *many* warnings.
WARN_LEVEL=

# Error log generation
# Enable (1) or disable (0) collection of build errors
# into a separate errors log file.
ERROR_LOG=

# Dependency handling (Homebrew)
# Automatically update and upgrade Homebrew dependencies
# before starting the build if set to 1 (disable set to 0)
UPDATE_DEPS=

# Git repository auto-update
# If set to 1, automatically pull new commits from the HandBrake Git
# repository if the local branch is behind the upstream.
AUTO_GIT_PULL=

# Additional configure options
# Extra options appended to ./configure.
# Example:
#   ADD_CONFIG_OPTS="--df-jobs=3 --lto=thin"
ADD_CONFIG_OPTS=""

# macOS notarization
# Enable (1) or disable (0) notarization of the built application.
NOTARY_ENABLE=

# Apple ID used for notarization
NOTARY_USERNAME=""

# Apple Developer Team ID used for notarization
NOTARY_TEAMID=""

# IMPORTANT:
# The notarization password is NOT stored here.
# It must be stored in the macOS Keychain:
#
#   security add-generic-password \
#       -a "<apple-id>" \
#       -s "HandBrakeNotary" \
#       -w "<app-specific-password>"
#
# The build script will retrieve it automatically.
# ------------------------------------------------------------

# Create a installer file at the end of the build
MAKE_INSTALLER=

# Custom compiler flags
# Additional compiler flags to append to the build.
# These are optional and advanced usage.
CFLAGS=""
CXXFLAGS=""
OBJCFLAGS=""
OBJCXXFLAGS=""
EOF

                echo "✔ Configuration file created from template:"
                echo "   $CONFIG_FILE"
                ;;
            *)
                echo "ℹ️  Running script with default values"
                # Check DEV_DIR pand set to default if needed
                if [[ -z "$DEV_DIR" ]]; then
                    DEV_DIR="$HOME/Developer"
                    echo "⚠️  DEV_DIR was empty – automatically set to $DEV_DIR"
                fi
                ;;
        esac
    fi

    # After loading check if DEV_DIR is still empty
    if [[ -z "$DEV_DIR" ]]; then
        DEV_DIR="$HOME/Developer"
        echo "⚠️  DEV_DIR still empty after loading – automatically set to $DEV_DIR"
    fi
}

load_config

#######################################
# Enforce defaults (nounset safety)
#######################################

: "${DEV_DIR:=$HOME/Developer}"

: "${HB_GIT_REF:=master}"

: "${ENABLE_LOG:=}"
: "${WARN_LOG:=}"
: "${WARN_LEVEL:=}"
: "${ERROR_LOG:=}"
: "${UPDATE_DEPS:=}"
: "${AUTO_GIT_PULL:=}"
: "${ADD_CONFIG_OPTS:=}"
: "${MAKE_INSTALLER:=}"

: "${NOTARY_ENABLE:=0}"
: "${NOTARY_USERNAME:=}"
: "${NOTARY_TEAMID:=}"

: "${CFLAGS:=}"
: "${CXXFLAGS:=}"
: "${OBJCFLAGS:=}"
: "${OBJCXXFLAGS:=}"

validate_environment
#######################################
# Derived configuration
#######################################

ROOT="$DEV_DIR/HandBrake"
BUILD_DIR="$ROOT/build"
INSTALL_APP="/Applications/HandBrake.app"
APP_BIN="$BUILD_DIR/xroot/HandBrake.app/Contents/MacOS/HandBrake"
LOGDIR="$CONFIG_DIR/logs"
LOGFILE="$LOGDIR/build-$(date '+%Y%m%d-%H%M').log"
WARNLOG="$LOGDIR/warnings-$(date '+%Y%m%d-%H%M').log"
ERRORLOG="$LOGDIR/errors-$(date '+%Y%m%d-%H%M').log"

#######################################
# Check for cargo-c
#######################################

install_cargo_c() {
    # Check if Cargo is available
    if ! command -v cargo >/dev/null 2>&1; then
        echo "ℹ️ Rust / Cargo not found – installing via rustup"
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
        export PATH="$HOME/.cargo/bin:$PATH"
    fi

    # Check if cargo-c is installed
    if command -v cargo-c >/dev/null 2>&1; then
        echo "✔ cargo-c already installed – updating..."
        cargo install cargo-c --force
    else
        echo "⬇️ Installing cargo-c via cargo"
        cargo install cargo-c
    fi
}

#######################################
# Homebrew check / install
#######################################

if ! has_command brew; then
    echo "🍺  Homebrew not found – starting installation"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
else
    echo "✔ Homebrew is installed"
fi

#######################################
# Homebrew dependencies
#######################################

install_homebrew_deps() {

BREW_DEPS=(
    autoconf
    automake
    cmake
    libtool
    meson
    nasm
    ninja
    pkg-config
    unix2dos
)

MISSING_DEPS=()

for dep in "${BREW_DEPS[@]}"; do
    brew list --formula "$dep" >/dev/null 2>&1 || MISSING_DEPS+=("$dep")
done

if (( ${#MISSING_DEPS[@]} > 0 )); then
    echo "⬇️  Installing missing Homebrew dependencies:"
    printf '  - %s\n' "${MISSING_DEPS[@]}"
    brew install "${MISSING_DEPS[@]}"
else
    echo "✔ All Homebrew dependencies are installed"
fi
}

# Homebrew-Tools
install_homebrew_deps

# Rust/Cargo Tools
install_cargo_c

#######################################
# HandBrake repository
#######################################

if [[ ! -d "$ROOT/.git" ]]; then
    echo "📦  HandBrake repository not found – cloning into $DEV_DIR"
    cd "$DEV_DIR"
    git clone https://github.com/HandBrake/HandBrake.git
else
    echo "✔ HandBrake repository present"
fi

#######################################
# Logging
#######################################

log_header() {
    if [[ "$ENABLE_LOG" == "1" ]]; then
        mkdir -p "$LOGDIR"
        find "$LOGDIR" -type f -name 'build-*.log' -mtime +14 -delete || true
        find "$LOGDIR" -type f \( \
        -name 'build-*.log' \
        -o -name 'warnings-*.log' \
        -o -name 'errors-*.log' \
        \) -mtime +14 -delete || true
        ls -1t "$LOGDIR"/build-*.log(N) | tail -n +50 | xargs -r rm --
        ls -1t "$LOGDIR"/warnings-*.log(N) | tail -n +50 | xargs -r rm --
        ls -1t "$LOGDIR"/errors-*.log(N) | tail -n +50 | xargs -r rm --
        exec > >(tee -a "$LOGFILE") 2>&1
    fi
}

log_header

#######################################
# Git-Update
#######################################

check_git_updates() {

    cd "$ROOT" || fail 1 $LINENO "Directory $ROOT not found"

    [[ -d .git ]] || {
        echo "ℹ️  Not a Git repository"
        return
    }

    # Check which branch we are currently on
    local current_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD)

    # Only run AUTO_GIT_PULL on master
    if [[ "$current_branch" != "master" ]]; then
        echo "ℹ️ AUTO_GIT_PULL ignored: currently on '$current_branch' (not master)"
        return
    fi

    if [[ "$AUTO_GIT_PULL" != "1" ]]; then
        echo "ℹ️  AUTO_GIT_PULL disabled"
        return
    fi

    echo "🔍 Checking Git repository state"
    git fetch --quiet origin

    if ! git pull --ff-only; then
        echo "❌ git pull failed"

        if git status --porcelain | grep -E '^(UU|AA|DD)' >/dev/null; then
            echo "🔀 Merge conflicts detected:"
            git status --porcelain | awk '/^(UU|AA|DD)/ { print "   - " $2 }'
        else
            echo "ℹ️ Git status:"
            git status --short
        fi

        fail 1 $LINENO "git pull failed"
    fi
}

check_git_updates

#######################################
# Git reference selection (branch/tag)
#######################################
is_detached_head() {
    ! git symbolic-ref -q HEAD >/dev/null
}

find_latest_auto_stash() {
    git stash list |
        grep -m1 '^stash@{[0-9]\+}: Auto-stash before switching to ' |
        sed 's/:.*//'
}

select_git_ref() {
    cd "$ROOT" || fail 1 $LINENO "Directory $ROOT not found"

    local ref="$HB_GIT_REF"
    local resolved_ref=""
    local auto_stash=""

    # Temporarily disable 
    trap '' ERR
    echo "🔖 Selecting Git reference: $ref"
    trap '[[ $? -ne 0 ]] && fail $? $LINENO "${ZSH_DEBUG_CMD:-<no command>}"' ERR

    git fetch --all --tags --quiet

    # Determine current ref (branch or tag/detached HEAD)
    local current_ref
    current_ref=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || git describe --tags --exact-match HEAD 2>/dev/null || echo "DETACHED")

    # Check whether we really switch
    local will_switch=0
    if [[ "$ref" == "master" && "$current_ref" != "master" ]]; then
        will_switch=1
    elif git tag -l | grep -qx "$ref" && [[ "$current_ref" != "$ref" ]]; then
        will_switch=1
    elif git branch -r | sed 's|origin/||' | grep -E '^[0-9]+\.[0-9]+\.x$' | grep -qx "$ref" && [[ "$current_ref" != "$ref" ]]; then
        will_switch=1
    fi

    # Only warn if a ref change is planned
    if (( will_switch )) && ! is_detached_head && [[ -n "$(git status --porcelain)" ]]; then
        echo "⚠️  Local changes detected in HandBrake repository!"
        echo "▶ Showing 'git diff' for review:"
        git --no-pager diff

        # Create backup patch
        local backup_dir="$CONFIG_DIR/git-backups"
        mkdir -p "$backup_dir"
        local patch_file="$backup_dir/backup-$(date '+%Y%m%d-%H%M%S').patch"
        git diff > "$patch_file"
        echo "💾 Backup patch created: $patch_file"

        # Interactive question about stashing
        read "stash_answer?Do you want to automatically stash these changes before switching Git reference? [y/N]: "
        if [[ "$stash_answer" =~ ^[Yy]$ ]]; then
            git stash push -u -m "Auto-stash before switching to $ref"
            echo "✔ Changes stashed"
        else
            echo "❌ Ref switch aborted to prevent data loss"
            return 1
        fi
    fi

    # Resolve "latest"
    if [[ "$ref" == "latest" ]]; then
        resolved_ref="$(git tag -l | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n 1 || true)"
        [[ -n "$resolved_ref" ]] || fail 1 $LINENO "Unable to resolve 'latest' – no valid release tags found"
        echo "✔ Resolved 'latest' to release tag: $resolved_ref"
        ref="$resolved_ref"
    fi

    # Tags & Branches
    trap '' ERR
    tags=("${(@f)$(git tag -l || true)}")
    branches=("${(@f)$(git branch -r | sed 's|origin/||' | grep -E '^[0-9]+\.[0-9]+\.x$' || true)}")
    trap '[[ $? -ne 0 ]] && fail $? $LINENO "${ZSH_DEBUG_CMD:-<no command>}"' ERR
    
    # Checkout
if [[ "$ref" == "master" ]]; then
    if is_detached_head; then
        echo "🔁 Returning from detached HEAD to master"
        git checkout master --quiet

        auto_stash="$(find_latest_auto_stash || true)"

        if [[ -n "$auto_stash" ]]; then
            echo "💾 Auto-stash detected: $auto_stash"
            read "restore_answer?Restore previously stashed changes? [y/N]: "

            if [[ "$restore_answer" =~ ^[Yy]$ ]]; then
                echo "▶ Applying stash"
                if git stash apply "$auto_stash"; then
                    git stash drop "$auto_stash"
                    echo "✔ Stash successfully restored and removed"
                else
                    echo "❌ Stash apply failed – conflicts may exist"
                    echo "ℹ️ Resolve conflicts manually; stash has NOT been dropped"
                    return 1
                fi
            else
                echo "ℹ️ Stash kept for manual recovery"
            fi
        fi

    elif (( will_switch )); then
        echo "✔ Switching to master"
        git checkout master --quiet
    else
        echo "✔ Staying on master – no ref change needed"
    fi
    elif (( ${tags[(Ie)$ref]} )); then
        echo "✔ Using release tag: $ref"
        git checkout --detach "$ref" --quiet
    elif (( ${branches[(Ie)$ref]} )); then
        echo "✔ Using release branch: $ref"
        git checkout -B "$ref" "origin/$ref" --quiet
    else
        echo
        echo "❌ Invalid Git reference: $ref"
        echo
        echo "Valid tags:"
        if (( ${#tags[@]} )); then
            printf '  - %s\n' "${tags[@]}"
        else
            echo "  (none found)"
        fi
        echo
        echo "Valid release branches:"
        if (( ${#branches[@]} )); then
            printf '  - %s\n' "${branches[@]}"
        else
            echo "  (none found)"
        fi
        echo
        echo "Hint:"
        echo "  - Use a release tag (e.g. 1.10.2) for reproducible builds."
        echo "  - Use a release branch (e.g. 1.10.x) only if you need the latest fixes."
        echo
        fail 1 $LINENO "Invalid Git reference"
    fi
}

select_git_ref
log_build_metadata

#######################################
# Determine Developer-ID
#######################################

SIGNINGHASH=$(
    security find-identity -p codesigning -v |
    awk '/Developer ID Application:/ { print $2; exit }'
)

[[ -n "$SIGNINGHASH" ]] || fail 1 $LINENO "No Developer ID found"

#######################################
# Set warning levels
#######################################

WARNING_FLAGS=""

case "${WARN_LEVEL:-}" in
    ""|0)
        ;;
    1)
        WARNING_FLAGS="-Wall -Wextra"
        ;;
    2)
        WARNING_FLAGS="-Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wsign-conversion"
        ;;
    *)
        fail 1 $LINENO "Invalid WARNING_LEVEL=${WARN_LEVEL}"
        ;;
esac

#######################################
# Append warning flags
#######################################

if [[ -n "$WARNING_FLAGS" ]]; then
    CFLAGS="$CFLAGS $WARNING_FLAGS"
    CXXFLAGS="$CXXFLAGS $WARNING_FLAGS"
    OBJCFLAGS="$OBJCFLAGS $WARNING_FLAGS"
    OBJCXXFLAGS="$OBJCXXFLAGS $WARNING_FLAGS"
fi

#######################################
# Export compiler flags
#######################################

[[ -n "$CFLAGS" ]] && export CFLAGS
[[ -n "$CXXFLAGS" ]] && export CXXFLAGS
[[ -n "$OBJCFLAGS" ]] && export OBJCFLAGS
[[ -n "$OBJCXXFLAGS" ]] && export OBJCXXFLAGS

#######################################
# Dependencies
#######################################

install_deps() {
    if [[ "$UPDATE_DEPS" != "1" ]]; then
        return
    fi

    check_command brew
    brew update
    brew upgrade
    brew cleanup
    command -v rustup >/dev/null && rustup update || true
}

install_deps

#######################################
# Clean
#######################################

clean_build() {
    [[ "$BUILD_DIR" == "$ROOT"/build ]] || fail 1 $LINENO "Invalid build directory"
    rm -rf "$BUILD_DIR"
    rm -f "$ROOT/hbsign.log"
    rm -rf "$ROOT/macosx/DerivedData"
}

clean_build

#######################################
# Configure and build
#######################################

configure_handbrake() {
    cd "$ROOT" || fail 1 $LINENO "Directory $ROOT not found"

    JOBS=$(sysctl -n hw.perflevel0.logicalcpu 2>/dev/null || sysctl -n hw.ncpu)
    JOBS=${JOBS:-4}

echo "▶ ./configure options:"
echo "   --launch-jobs=$JOBS --launch $ADD_CONFIG_OPTS"

typeset -a CONFIG_OPTS
CONFIG_OPTS=(${(z)${ADD_CONFIG_OPTS:-}})

./configure \
    --launch-jobs="$JOBS" \
    --launch \
    "${CONFIG_OPTS[@]}"
}

build_handbrake() {
    cd "$BUILD_DIR" || fail 1 $LINENO "Build directory not found"
    echo "▶ Running make build"

    set +e
    make build 2>&1 | tee -a "$LOGFILE"
    local rc=${pipestatus[1]}
    set -e

    if (( rc != 0 )); then
        echo
        echo "❌ Build failed during compilation"
        echo "🔍 Last compiler errors:"

        grep -E "error:|fatal error:" "$LOGFILE" | tail -n 20 | sed 's/^/   /'

        fail "$rc" $LINENO "make build failed"
    fi

}

configure_handbrake
build_handbrake

#######################################
# Sign
#######################################

sign_handbrake() {
    echo "Signing the build"
    make sign ID="$SIGNINGHASH"
}

sign_handbrake

#######################################
# Notarization
#######################################
validate_notary_config() {
    if [[ "$NOTARY_ENABLE" != "1" ]]; then
    return
fi

    [[ -n "$NOTARY_USERNAME" ]] || fail 1 $LINENO "NOTARY_USERNAME required when NOTARY_ENABLE=1"
    [[ -n "$NOTARY_TEAMID"  ]] || fail 1 $LINENO "NOTARY_TEAMID required when NOTARY_ENABLE=1"
}

get_notary_password() {
    if [[ "$NOTARY_ENABLE" != "1" ]]; then
        return
    fi

    security find-generic-password \
        -a "$NOTARY_USERNAME" \
        -s "HandBrakeNotary" \
        -w 2>/dev/null
}

run_notarization() {
    if [[ "$NOTARY_ENABLE" != "1" ]]; then
        echo "ℹ️ Notarization disabled"
        return
    fi

    NOTARY_PASSWORD="$(get_notary_password)"

    [[ -n "$NOTARY_PASSWORD" ]] || fail 1 $LINENO "Notary password not found in keychain"

    echo "🔐  Starting notarization"
    cd "$BUILD_DIR" || fail 1 $LINENO "Build directory not found"

    set +e
    make notarize \
        USERNAME="$NOTARY_USERNAME" \
        TEAMID="$NOTARY_TEAMID" \
        PASSWORD="$NOTARY_PASSWORD"
    local NOTARY_RC=$?
    set -e

    if (( NOTARY_RC != 0 )); then
        echo "❌  Notarization failed (exit code $NOTARY_RC)"
        echo
        echo "ℹ️  Last notarytool history (if available):"

        xcrun notarytool history \
            --apple-id "$NOTARY_USERNAME" \
            --team-id "$NOTARY_TEAMID" 2>/dev/null || true

        return "$NOTARY_RC"
    fi

    echo "✔ Notarization successful"
}
validate_notary_config
run_notarization

#######################################
# Install
#######################################

install_app() {
    [[ -x "$APP_BIN" ]] || fail 1 $LINENO "Application binary does not exist"
    [[ -d "$INSTALL_APP" ]] || echo "ℹ️ Target application does not yet exist"
    cd "$BUILD_DIR" || fail 1 $LINENO "Build directory not found"
    echo "The finished HandBrake build will now be installed in the Application folder"
    make install
}

install_app

#######################################
# Security checks
#######################################

verify_app() {
    codesign --verify --deep --strict --verbose=4 "$INSTALL_APP" \
        || fail $? $LINENO "Code signing verification failed"

    if [[ "$NOTARY_ENABLE" == "1" ]]; then
        spctl -a -vvv -t install "$INSTALL_APP" \
            || fail $? $LINENO "spctl assessment failed"

        stapler validate "$INSTALL_APP" \
            || fail $? $LINENO "stapler validation failed"
    else
        echo "ℹ️  Notary disabled: Skipping Gatekeeper & stapler checks"
    fi
}

verify_app

optional_checks() {
    command -v check-signature >/dev/null 2>&1 && check-signature "$INSTALL_APP" || true
    otool -hv "$INSTALL_APP/Contents/MacOS/HandBrake"
    otool -Iv "$INSTALL_APP/Contents/MacOS/HandBrake" | grep -i stack || true
}

optional_checks

#######################################
# Success
#######################################

command -v afplay >/dev/null && afplay /System/Applications/Music.app/Contents/Resources/complete.aif || true
command -v terminal-notifier >/dev/null && /Applications/terminal-notifier.app/Contents/MacOS/terminal-notifier \
    -title "HandBrake" \
    -message "$(date '+%d-%m-%Y %H:%M'): Build successful"
    
#######################################
# Package creation (optional)
#######################################

create_pkg() {
    if [[ "$MAKE_INSTALLER" != "1" ]]; then
        echo "ℹ️  Package creation disabled"
        return
    fi

    echo "📦  Creating release artifacts"

    cd "$BUILD_DIR" || fail 1 $LINENO "Build directory not found"

    set +e
    make pkg.create
    local PKG_RC=$?
    set -e

    (( PKG_RC == 0 )) || fail "$PKG_RC" $LINENO "Package creation failed"

    echo "✔ Release artifacts created:"
    ls -lh pkg/*.dmg pkg/*.tar.bz2 pkg/*.xml 2>/dev/null | sed 's/^/   /'

    echo "✔ Package created"
    echo "🔑  SHA-256 checksums:"
    (
        cd pkg || exit 1
        shasum -a 256 *.dmg *.tar.bz2 2>/dev/null
    )
}

#######################################
# Collect compiler warnings
#######################################

collect_warnings() {
    if [[ "$WARN_LOG" != "1" ]]; then
        return
    fi

    echo "▶ Collecting compiler warnings"

    : > "$WARNLOG"

    sed -E 's/\x1B\[[0-9;]*[mK]//g' "$LOGFILE" \
    | awk '
    BEGIN {
    IGNORECASE = 1
    warn = 0
}

/(^|[[:space:]])warning:/ {
    warn = 1
    sub(/^[[:space:]]*/, "  : ")
    print
    next
}

warn && /(^|[[:space:]])note:/ {
    sub(/^[[:space:]]*/, "  : ")
    print
    next
}

/^[^[:space:]]/ {
    warn = 0
}
' >> "$WARNLOG"

    if [[ -s "$WARNLOG" ]]; then
        echo "⚠️  Compiler warnings found: $(wc -l < "$WARNLOG")"
        echo "   → $WARNLOG"
    else
        rm -f "$WARNLOG"
        echo "✔ No compiler warnings found"
    fi
}

collect_warnings
create_pkg
exit 0