#!/usr/bin/env zsh
#
# hb-builder — HandBrake macOS build & notarization helper
#
# Copyright (c) 2026, Nomis101
# All rights reserved.
#
# This source code is licensed under the BSD-style license found in the
# LICENSE file in the root directory of this source tree. 
#
# Requires:
#   - macOS 12+
#   - Xcode Command Line Tools
#   - Homebrew
#

set -euo pipefail
IFS=$'\n\t'
setopt EXTENDED_GLOB
umask 077

# Security: sanitize PATH to prevent execution of attacker-planted binaries
# (includes the standard Homebrew prefixes and rustup's cargo bin so existing
# installations are detected on both Intel and Apple Silicon)
PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.cargo/bin"

# Resolve this script's real location early – inside a zsh function $0 is the
# function name (FUNCTION_ARGZERO), so it must be captured at top level
SCRIPT_DIR="${0:A:h}"

# Capture whether stdout is a terminal BEFORE log_header replaces it with the
# tee pipe – "[[ -t 1 ]]" is always false after that redirect
[[ -t 1 ]] && _STDOUT_TTY=1 || _STDOUT_TTY=0

# terminal-notifier app bundle (verified with -x before every use)
TERMINAL_NOTIFIER="/Applications/terminal-notifier.app/Contents/MacOS/terminal-notifier"

#######################################
# Location for buildconfig.conf file
#######################################

CONFIG_DIR="$HOME/Library/Application Support/HandBrakeBuilder"
CONFIG_FILE="$CONFIG_DIR/buildconfig.conf"

#######################################
# Environment validation
#######################################

validate_environment() {
    echo "▶ Validating build environment"

    # --- macOS version ---
    local macos_major
    macos_major=$(sw_vers -productVersion | awk -F. '{print $1}')

    if (( macos_major < 12 )); then
        fail 1 $LINENO "macOS 12 or newer is required"
    fi

    # --- Xcode Command Line Tools ---
    if ! xcode-select -p >/dev/null 2>&1; then
        fail 1 $LINENO "Xcode Command Line Tools are not installed"
    fi

    # --- Required tools ---
    local required_tools=(
        git
        clang
        make
        xcrun
        codesign
    )

    for tool in "${required_tools[@]}"; do
        has_command "$tool" || fail 1 $LINENO "Required tool not found: $tool"
    done

    # --- Notarization tools (conditional) ---
    if [[ "$NOTARY_ENABLE" == "1" ]]; then
        xcrun notarytool help >/dev/null 2>&1 \
            || fail 1 $LINENO "notarytool not available (Xcode 13+ required)"
    fi

    # --- Development directory ---
    mkdir -p "$DEV_DIR" || fail 1 $LINENO "Cannot create DEV_DIR: $DEV_DIR"

    # --- Disk space ---
    local avail_kb required_kb
    avail_kb=$(df -Pk "$DEV_DIR" | awk 'NR==2 {print $4}')
    required_kb=$((30 * 1024 * 1024)) # 30 GB

    if (( avail_kb < required_kb )); then
        fail 1 $LINENO "Insufficient disk space in DEV_DIR (need ≥ 30 GB)"
    fi

    echo "✔ Environment validation passed"
}

#######################################
# Collect build errors
#######################################

collect_errors() {
    if [[ "${ERROR_LOG:-}" != "1" ]]; then
        return
    fi

    # No build log yet (early failure or ENABLE_LOG=0) – nothing to collect
    [[ -f "${LOGFILE:-}" ]] || return 0

    mkdir -p "$LOGDIR"
    : > "$ERRORLOG"

    sed -E 's/\x1B\[[0-9;]*[mK]//g' "$LOGFILE" 2>/dev/null \
    | awk '
    BEGIN {
        err = 0
        done = 0
    }

    # BSD awk has no IGNORECASE – match against a lowercased copy instead
    { low = tolower($0) }

    # ---- primary error trigger ----
    !done && low ~ /(^|[[:space:]])(fatal error:|error:|syntaxerror|internal inconsistency error|build interrupted)/ {
        err = 1
        done = 1
        sub(/^[[:space:]]*/, "  : ")
        print
        next
    }

    # ---- allowed continuation lines ----
    err && low ~ /included from/ {
        sub(/^[[:space:]]*/, "  : ")
        print
        next
    }
    err && /^[[:space:]]*\|/ {
        sub(/^[[:space:]]*/, "  : ")
        print
        next
    }
    err && /^[[:space:]]*\^/ {
        sub(/^[[:space:]]*/, "  : ")
        print
        next
    }
    err && low ~ /^[[:space:]]*[0-9]+ error generated/ {
        sub(/^[[:space:]]*/, "  : ")
        print
        next
    }
    err && /make(\[[0-9]+\])?: \*\*\*/ {
        sub(/^[[:space:]]*/, "  : ")
        print
        next
    }
    err && low ~ /\*\* build interrupted \*\*/ {
        sub(/^[[:space:]]*/, "  : ")
        print
        next
    }

    # ---- hard stop conditions (NO GROUPING!) ----
    err && /^\/usr\/bin\/gcc/   { err = 0; next }
    err && /^\/usr\/bin\/clang/ { err = 0; next }
    err && /^[[:space:]]*cd[[:space:]]/ { err = 0; next }
    err && /^[[:space:]]*builtin-/ { err = 0; next }
    err && /^[[:space:]]*ProcessXCFramework/ { err = 0; next }
    err && /^[[:space:]]*Command ExternalBuildToolExecution/ { err = 0; next }

    ' >> "$ERRORLOG"

    [[ -s "$ERRORLOG" ]] || rm -f "$ERRORLOG"
}

#######################################
# Support Functions
#######################################

fail() {
    local exit_code="${1:-1}"
    local line="${2:-unknown}"
    local cmd="${3:-<no command>}"
    
    collect_errors

    command -v afplay >/dev/null && afplay /System/Library/Sounds/Funk.aiff || true
    [[ -x "$TERMINAL_NOTIFIER" ]] && "$TERMINAL_NOTIFIER" \
        -title "HandBrake" \
        -message "$(date '+%d-%m-%Y %H:%M'): Build failed (Exit $exit_code, Line $line)" || true

    echo "❌  Build failed"
    echo "   Exit code : $exit_code"
    echo "   Line      : $line"
    echo "   Command   : $cmd"

    if [[ -s "${ERRORLOG:-}" ]]; then
        echo "❌  Error log written:"
        echo "   → $ERRORLOG"
        (( ${_STDOUT_TTY:-0} )) && open -R "$ERRORLOG"
    fi

    exit "$exit_code"
}

# Guard: set to 1 around blocks that handle errors manually – the ERR trap
# fires even while "set +e" is in effect, which would bypass those handlers
_ERR_TRAP_OFF=0
trap 'rc=$?; (( _ERR_TRAP_OFF )) || fail $rc $LINENO "${ZSH_DEBUG_CMD:-<no command>}"' ERR

# Track mktemp files so they are removed even when fail() aborts a step
# between mktemp and the step's own "rm -f" (ERR trap exits immediately)
typeset -a _TMPFILES
_cleanup_tmpfiles() {
    local _f
    for _f in "${_TMPFILES[@]}"; do
        [[ -f "$_f" ]] && rm -f -- "$_f"
    done
    return 0
}
trap '_cleanup_tmpfiles' EXIT

has_command() {
    command -v "$1" >/dev/null 2>&1
}

check_command() {
    has_command "$1" || fail 1 $LINENO "Required command not found: $1"
}

log_intro() {
    echo "========================================"
    echo "HandBrake build started"
    echo "Time: $(date)"
    echo "Host: $(hostname)"
    echo "========================================"
}

log_build_metadata() {
    echo "----------------------------------------"
    echo "Build metadata"
    echo "Git commit  : $(git rev-parse --short HEAD 2>/dev/null || echo n/a)"
    echo "Git branch  : $(git branch --show-current 2>/dev/null || echo n/a)"
    echo "Git state   : $(git symbolic-ref --short HEAD 2>/dev/null || echo DETACHED)"
    echo "Compiler    : $(clang --version | head -n 1)"
    echo "macOS       : $(sw_vers -productVersion)"
    echo "Git ref     : ${HB_GIT_REF}"
    echo "Arch        : $(uname -m)"
    echo "SDK         : $(xcrun --show-sdk-version)"
    echo "Notary      : ${NOTARY_ENABLE:-0}"
    echo "Deps update : ${UPDATE_DEPS:-}"
    echo "Auto pull   : ${AUTO_GIT_PULL:-}"
    echo "Add config  : ${ADD_CONFIG_OPTS:-}"
    echo "Log warnings: ${WARN_LOG:-}"
    echo "Warn level  : ${WARN_LEVEL:-}"
    echo "Log errors  : ${ERROR_LOG:=}"
    echo "----------------------------------------"
}
log_intro

#######################################
# Load configuration file
#######################################

load_config() {
    # Offer to create a template on first run
    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo "ℹ️  No configuration file found:"
        echo "   $CONFIG_FILE"

        local answer=""
        if [[ -t 0 ]]; then
            read "answer?Create a configuration file from template? [Yes/No]: "
        else
            echo "ℹ️  Non-interactive mode – running with default values"
        fi

        case "$answer" in
            Yes|yes|Y|y)
                echo "Creating configuration file"
                mkdir -p "$CONFIG_DIR"
                chmod 0700 "$CONFIG_DIR"
                
                # Write template with restricted permissions
                install -m 0600 /dev/null "$CONFIG_FILE"
                cat <<'EOF' > "$CONFIG_FILE"
# ============================================================
# HandBrake Builder – buildconfig.conf
#
# This file controls how the HandBrake build script behaves.
# All values are optional. If a value is empty, a sensible
# default will be used by the build script.
#
# The file is sourced by zsh – keep valid shell syntax!
# ============================================================


# Absolute path to your development directory.
# Examples:
#   DEV_DIR="$HOME/Developer"
#   DEV_DIR="/Volumes/Developer"
DEV_DIR="$HOME/Developer"

# Git reference to build
# Valid values:
#   - master (default)
#   - release tags, e.g. 1.10.2
#   - latest (highest semantic version tag)
HB_GIT_REF="master"

# Log generation
# Enable (1) or disable (0) collection of compiler log
# into a log file
ENABLE_LOG=1

# Error log generation
# Enable (1) or disable (0) collection of build errors
# into a separate errors log file.
ERROR_LOG=

# Compiler warning verbosity (set from 0 to 2)
# Higher levels can generate *many* warnings.
WARN_LEVEL=

# Warning log generation
# Enable (1) or disable (0) collection of compiler warnings
# into a separate warnings log file.
WARN_LOG=

# Dependency handling (Homebrew)
# Automatically update and upgrade Homebrew dependencies
# before starting the build if set to 1 (disable set to 0)
UPDATE_DEPS=

# Git repository auto-update
# If set to 1, automatically pull new commits from the HandBrake Git
# repository if the local branch is behind the upstream.
AUTO_GIT_PULL=

# Auto apply patches located in the patch folder
APPLY_PATCHES=

# Activate functional test at the end of the build process
# to function test the build
FUNCTIONAL_TEST=

# Additional configure options
# Extra options appended to ./configure.
# Example:
#   ADD_CONFIG_OPTS="--df-jobs=3 --lto=thin"
ADD_CONFIG_OPTS=""

# macOS notarization
# Enable (1) or disable (0) notarization of the built application.
NOTARY_ENABLE=

# Apple ID used for notarization
NOTARY_USERNAME=""

# Apple Developer Team ID used for notarization
NOTARY_TEAMID=""

# IMPORTANT:
# The notarization password is NOT stored here.
# It must be stored in the macOS Keychain:
#
#   security add-generic-password \
#       -a "<apple-id>" \
#       -s "HandBrakeNotary" \
#       -w "<app-specific-password>"
#
# The build script will retrieve it automatically.
# ------------------------------------------------------------

# Create a installer file at the end of the build
MAKE_INSTALLER=

# Custom compiler flags
# Additional compiler flags to append to the build.
# These are optional and advanced usage.
CFLAGS=""
CXXFLAGS=""
OBJCFLAGS=""
OBJCXXFLAGS=""
EOF

                echo "✔ Configuration file created from template:"
                echo "   $CONFIG_FILE"
                ;;
            *)
                echo "ℹ️  Running script with default values"
                ;;
        esac
    fi

    # Load the configuration file (including a template created above)
    if [[ -f "$CONFIG_FILE" ]]; then
        # Security: verify config file ownership and permissions before sourcing
        if [[ ! -O "$CONFIG_FILE" ]]; then
            fail 1 $LINENO "Config file not owned by current user: $CONFIG_FILE"
        fi
        local _cfg_mode
        _cfg_mode=$(stat -f '%Lp' "$CONFIG_FILE")
        if (( 8#$_cfg_mode & 8#022 )); then
            fail 1 $LINENO "Config file is group/world-writable (mode $_cfg_mode): $CONFIG_FILE"
        fi
        # Security: copy to temp file and source the copy to eliminate TOCTOU window
        _VALIDATED_CONFIG=$(mktemp "${TMPDIR:-/tmp}/hb-config.XXXXXX")
        _TMPFILES+=("$_VALIDATED_CONFIG")
        cp "$CONFIG_FILE" "$_VALIDATED_CONFIG"
        chmod 0600 "$_VALIDATED_CONFIG"
        echo "✔ Configuration file found – loading"
        source "$_VALIDATED_CONFIG"
    fi

    # After loading check if DEV_DIR is still empty or unset
    if [[ -z "${DEV_DIR:-}" ]]; then
        DEV_DIR="$HOME/Developer"
        echo "⚠️  DEV_DIR empty after loading – automatically set to $DEV_DIR"
    fi
}

load_config

#######################################
# Enforce defaults (nounset safety)
#######################################

# Security: clear sensitive variables to prevent environment injection
unset ADD_CONFIG_OPTS CFLAGS CXXFLAGS OBJCFLAGS OBJCXXFLAGS 2>/dev/null || true

# Re-source validated config copy to set variables (never re-read the original)
if [[ -n "${_VALIDATED_CONFIG:-}" && -f "$_VALIDATED_CONFIG" ]]; then
    source "$_VALIDATED_CONFIG"
    rm -f "$_VALIDATED_CONFIG"
    unset _VALIDATED_CONFIG
fi

: "${DEV_DIR:=$HOME/Developer}"

: "${HB_GIT_REF:=master}"

: "${ENABLE_LOG:=}"
: "${WARN_LOG:=}"
: "${WARN_LEVEL:=}"
: "${ERROR_LOG:=}"
: "${UPDATE_DEPS:=}"
: "${AUTO_GIT_PULL:=}"
: "${ADD_CONFIG_OPTS:=}"
: "${MAKE_INSTALLER:=}"
: "${APPLY_PATCHES:=}"
: "${FUNCTIONAL_TEST:=}"

: "${NOTARY_ENABLE:=0}"
: "${NOTARY_USERNAME:=}"
: "${NOTARY_TEAMID:=}"

: "${CFLAGS:=}"
: "${CXXFLAGS:=}"
: "${OBJCFLAGS:=}"
: "${OBJCXXFLAGS:=}"

validate_environment
#######################################
# Derived configuration
#######################################

ROOT="$DEV_DIR/HandBrake"
BUILD_DIR="$ROOT/build"
LOGDIR="$CONFIG_DIR/logs"
BACKUPDIR="$CONFIG_DIR/git-backups"
INSTALL_APP="/Applications/HandBrake.app"
APP_BIN="$BUILD_DIR/xroot/HandBrake.app/Contents/MacOS/HandBrake"
PATCHDIR="$CONFIG_DIR/patches"
LOGFILE="$LOGDIR/build-$(date '+%Y%m%d-%H%M').log"
WARNLOG="$LOGDIR/warnings-$(date '+%Y%m%d-%H%M').log"
ERRORLOG="$LOGDIR/errors-$(date '+%Y%m%d-%H%M').log"

#######################################
# Create all needed subfolders
#######################################

# Security: create directories then verify they are not symlinks (post-creation check)
for _dir in "$CONFIG_DIR" "$LOGDIR" "$BACKUPDIR" "$PATCHDIR"; do
    if [[ -L "$_dir" ]]; then
        fail 1 $LINENO "Directory path is a symlink (possible attack): $_dir"
    fi
    mkdir -p "$_dir"
    chmod 0700 "$_dir"
    if [[ -L "$_dir" ]]; then
        fail 1 $LINENO "Directory became a symlink after creation (race detected): $_dir"
    fi
done

#######################################
# Check for cargo-c
#######################################

install_cargo_c() {
    # Check if Cargo is available
    if ! command -v cargo >/dev/null 2>&1; then
        echo "ℹ️ Rust / Cargo not found – installing via rustup"
        local _rustup_installer
        _rustup_installer=$(mktemp "${TMPDIR:-/tmp}/rustup-init.XXXXXX")
        _TMPFILES+=("$_rustup_installer")
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o "$_rustup_installer"
        local _rustup_hash
        _rustup_hash=$(shasum -a 256 "$_rustup_installer" | awk '{print $1}')
        echo "⚠️  Downloaded rustup installer — SHA-256: $_rustup_hash"
        echo "   Verify this hash at https://rustup.rs before continuing."
        if [[ -t 0 ]]; then
            read "rust_answer?Proceed with rustup installation? [y/N]: "
            if [[ ! "$rust_answer" =~ ^[Yy]$ ]]; then
                rm -f "$_rustup_installer"
                fail 1 $LINENO "Rustup installation aborted by user"
            fi
        else
            # Security: never execute a freshly downloaded installer without
            # confirmation (same policy as the Homebrew install below)
            rm -f "$_rustup_installer"
            fail 1 $LINENO "Rustup install requires interactive confirmation"
        fi
        chmod +x "$_rustup_installer"
        "$_rustup_installer" -y
        rm -f "$_rustup_installer"
        export PATH="$HOME/.cargo/bin:$PATH"
    fi

    # Check if cargo-c is installed
    if command -v cargo-c >/dev/null 2>&1; then
        # "--force" always rebuilds cargo-c from source (several minutes),
        # so only refresh it when dependency updates are requested
        if [[ "$UPDATE_DEPS" == "1" ]]; then
            echo "✔ cargo-c already installed – updating (UPDATE_DEPS=1)"
            cargo install cargo-c --force --locked
        else
            echo "✔ cargo-c already installed"
        fi
    else
        echo "⬇️ Installing cargo-c via cargo"
        cargo install cargo-c --locked
    fi
}

#######################################
# Homebrew check / install
#######################################

if ! has_command brew; then
    echo "🍺  Homebrew not found – starting installation"
    local _brew_installer
    _brew_installer=$(mktemp "${TMPDIR:-/tmp}/brew-install.XXXXXX")
    _TMPFILES+=("$_brew_installer")
    curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$_brew_installer"
    local _brew_hash
    _brew_hash=$(shasum -a 256 "$_brew_installer" | awk '{print $1}')
    echo "⚠️  Downloaded Homebrew installer — SHA-256: $_brew_hash"
    echo "   Verify this hash at https://github.com/Homebrew/install before continuing."
    if [[ -t 0 ]]; then
        read "brew_answer?Proceed with Homebrew installation? [y/N]: "
        if [[ ! "$brew_answer" =~ ^[Yy]$ ]]; then
            rm -f "$_brew_installer"
            fail 1 $LINENO "Homebrew installation aborted by user"
        fi
    else
        fail 1 $LINENO "Homebrew install requires interactive confirmation"
    fi
    /bin/bash "$_brew_installer"
    rm -f "$_brew_installer"
    # Set up brew environment using explicit PATH instead of eval
    export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
else
    echo "✔ Homebrew is installed"
fi

#######################################
# Homebrew dependencies
#######################################

install_homebrew_deps() {

BREW_DEPS=(
    autoconf
    automake
    cmake
    libtool
    meson
    nasm
    ninja
    pkg-config
    unix2dos
)

MISSING_DEPS=()

for dep in "${BREW_DEPS[@]}"; do
    brew list --formula "$dep" >/dev/null 2>&1 || MISSING_DEPS+=("$dep")
done

if (( ${#MISSING_DEPS[@]} > 0 )); then
    echo "⬇️  Installing missing Homebrew dependencies:"
    printf '  - %s\n' "${MISSING_DEPS[@]}"
    brew install "${MISSING_DEPS[@]}"
else
    echo "✔ All Homebrew dependencies are installed"
fi
}

# Homebrew-Tools
install_homebrew_deps

# Rust/Cargo Tools
install_cargo_c

#######################################
# HandBrake repository
#######################################

if [[ ! -d "$ROOT/.git" ]]; then
    echo "📦  HandBrake repository not found – cloning into $DEV_DIR"
    cd "$DEV_DIR"
    # Note: clone is over HTTPS (transport security only). For tagged releases,
    # consider verifying GPG signatures with: git verify-tag "$ref"
    git clone https://github.com/HandBrake/HandBrake.git
else
    echo "✔ HandBrake repository present"
fi

#######################################
# Logging
#######################################

log_header() {
    if [[ "$ENABLE_LOG" == "1" ]]; then
        find "$LOGDIR" -type f \( \
        -name 'build-*.log' \
        -o -name 'warnings-*.log' \
        -o -name 'errors-*.log' \
        \) -mtime +14 -exec rm -f {} \; || true
        
        local files

        files=("$LOGDIR"/build-*.log(Nom))
        (( ${#files} > 49 )) && rm -f -- "${(@)files[50,-1]}"

        files=("$LOGDIR"/warnings-*.log(Nom))
        (( ${#files} > 49 )) && rm -f -- "${(@)files[50,-1]}"

        files=("$LOGDIR"/errors-*.log(Nom))
        (( ${#files} > 49 )) && rm -f -- "${(@)files[50,-1]}"

        # Pre-create the log file so it exists with the right permissions
        # before the asynchronous tee process starts (avoids a chmod race)
        : > "$LOGFILE"
        chmod 0600 "$LOGFILE"
        exec > >(tee -a "$LOGFILE") 2>&1
    fi
}

log_header

#######################################
# Git-Update
#######################################

check_git_updates() {

    cd "$ROOT" || fail 1 $LINENO "Directory $ROOT not found"

    [[ -d .git ]] || {
        echo "ℹ️  Not a Git repository"
        return
    }

    if [[ "$AUTO_GIT_PULL" != "1" ]]; then
        echo "ℹ️  AUTO_GIT_PULL disabled"
        return
    fi

    # Check which branch we are currently on
    local current_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD)

    # Only run AUTO_GIT_PULL on master
    if [[ "$current_branch" != "master" ]]; then
        echo "ℹ️ AUTO_GIT_PULL skipped: currently on '$current_branch' (not master)"
        return
    fi

    echo "🔍 Checking Git repository state"
    git fetch --quiet origin

    if ! git pull --ff-only; then
        echo "❌ git pull failed"

        if git status --porcelain | grep -E '^(UU|AA|DD)' >/dev/null; then
            echo "🔀 Merge conflicts detected:"
            git status --porcelain | awk '/^(UU|AA|DD)/ { print "   - " $2 }'
        else
            echo "ℹ️ Git status:"
            git status --short
        fi

        fail 1 $LINENO "git pull failed"
    fi
}

#######################################
# Git reference selection (branch/tag)
#######################################
is_detached_head() {
    ! git symbolic-ref -q HEAD >/dev/null
}

find_latest_auto_stash() {
    # "git stash push -m <msg>" entries list as: stash@{N}: On <branch>: <msg>
    git stash list |
        grep -m1 -E '^stash@[{][0-9]+[}]: On [^:]+: Auto-stash before switching to ' |
        sed 's/:.*//'
}

select_git_ref() {
    cd "$ROOT" || fail 1 $LINENO "Directory $ROOT not found"

    local ref="$HB_GIT_REF"
    local resolved_ref=""
    local auto_stash=""
    local stashed_this_run=0

    # Security: validate git ref format (alphanumeric, dots, dashes, underscores, slashes)
    if [[ "$ref" != "latest" ]] && [[ ! "$ref" =~ ^[A-Za-z0-9._/-]+$ ]]; then
        fail 1 $LINENO "Invalid characters in HB_GIT_REF: $ref"
    fi

    echo "🔖 Selecting Git reference: $ref"

    git fetch --all --tags --quiet

    # Tags & Branches (unquoted ${(f)...} so empty command output yields an
    # empty array instead of a single empty element)
    tags=(${(f)"$(git tag -l || true)"})
    branches=(${(f)"$(git branch -r | sed -E 's|^[[:space:]]*origin/||' | grep -E '^[0-9]+\.[0-9]+\.x$' || true)"})

    # Resolve "latest" BEFORE the switch detection below, so the local-change
    # safety net operates on the real target ref
    if [[ "$ref" == "latest" ]]; then
        resolved_ref="$(git tag -l | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n 1 || true)"
        [[ -n "$resolved_ref" ]] || fail 1 $LINENO "Unable to resolve 'latest' – no valid release tags found"
        echo "✔ Resolved 'latest' to release tag: $resolved_ref"
        ref="$resolved_ref"
    fi

    # Determine current ref (branch or tag/detached HEAD)
    local current_ref
    current_ref=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || git describe --tags --exact-match HEAD 2>/dev/null || echo "DETACHED")

    # Check whether we really switch
    local will_switch=0
    if [[ "$ref" == "master" && "$current_ref" != "master" ]]; then
        will_switch=1
    elif (( ${tags[(Ie)$ref]} )) && [[ "$current_ref" != "$ref" ]]; then
        will_switch=1
    elif (( ${branches[(Ie)$ref]} )) && [[ "$current_ref" != "$ref" ]]; then
        will_switch=1
    fi

    # Only warn if a ref change is planned (a detached HEAD counts too –
    # switching away from a tag must protect local changes as well)
    if (( will_switch )) && [[ -n "$(git status --porcelain)" ]]; then
        echo "⚠️  Local changes detected in HandBrake repository!"
        echo "▶ Showing 'git diff' for review:"
        git --no-pager diff

        # Create backup patch
        local backup_dir="$BACKUPDIR"
        local patch_file="$backup_dir/backup-$(date '+%Y%m%d-%H%M%S').patch"
        git diff > "$patch_file"
        echo "💾 Backup patch created: $patch_file"

        # Interactive question about stashing
        if [[ ! -t 0 ]]; then
            echo "❌ Non-interactive mode – ref switch aborted to prevent data loss"
            return 1
        fi
        read "stash_answer?Do you want to automatically stash these changes before switching Git reference? [y/N]: "
        if [[ "$stash_answer" =~ ^[Yy]$ ]]; then
            git stash push -u -m "Auto-stash before switching to ${ref//[^A-Za-z0-9._-]/}"
            stashed_this_run=1
            echo "✔ Changes stashed"
        else
            echo "❌ Ref switch aborted to prevent data loss"
            return 1
        fi
    fi

    # Checkout
if [[ "$ref" == "master" ]]; then
    if is_detached_head; then
        echo "🔁 Returning from detached HEAD to master"
        git checkout --quiet master

        # Do not offer to restore a stash that was just created above –
        # only stashes from earlier runs are candidates for restoration
        auto_stash=""
        (( stashed_this_run )) || auto_stash="$(find_latest_auto_stash || true)"

        if [[ -n "$auto_stash" ]]; then
            echo "💾 Auto-stash detected: $auto_stash"
            local restore_answer=""
            if [[ -t 0 ]]; then
                read "restore_answer?Restore previously stashed changes? [y/N]: "
            fi

            if [[ "$restore_answer" =~ ^[Yy]$ ]]; then
                echo "▶ Applying stash"
                if git stash apply "$auto_stash"; then
                    git stash drop "$auto_stash"
                    echo "✔ Stash successfully restored and removed"
                else
                    echo "❌ Stash apply failed – conflicts may exist"
                    echo "ℹ️ Resolve conflicts manually; stash has NOT been dropped"
                    return 1
                fi
            else
                echo "ℹ️ Stash kept for manual recovery"
            fi
        fi

    elif (( will_switch )); then
        echo "✔ Switching to master"
        git checkout --quiet master
    else
        echo "✔ Staying on master – no ref change needed"
    fi
    elif (( ${tags[(Ie)$ref]} )); then
        echo "✔ Using release tag: $ref"
        # Note: the ref must come BEFORE "--" (anything after is a pathspec)
        git checkout --detach --quiet "$ref" --
    elif (( ${branches[(Ie)$ref]} )); then
        echo "✔ Using release branch: $ref"
        git checkout -B "$ref" "origin/$ref" --quiet --
    else
        echo
        echo "❌ Invalid Git reference: $ref"
        echo
        echo "Valid tags:"
        if (( ${#tags[@]} )); then
            printf '  - %s\n' "${tags[@]}"
        else
            echo "  (none found)"
        fi
        echo
        echo "Valid release branches:"
        if (( ${#branches[@]} )); then
            printf '  - %s\n' "${branches[@]}"
        else
            echo "  (none found)"
        fi
        echo
        echo "Hint:"
        echo "  - Use a release tag (e.g. 1.10.2) for reproducible builds."
        echo "  - Use a release branch (e.g. 1.10.x) only if you need the latest fixes."
        echo
        fail 1 $LINENO "Invalid Git reference"
    fi
}

select_git_ref
check_git_updates
log_build_metadata

#######################################
# Determine Developer-ID
#######################################

SIGNINGHASH=$(
    security find-identity -p codesigning -v |
    awk '/Developer ID Application:/ { print $2; exit }'
)

[[ -n "$SIGNINGHASH" ]] || fail 1 $LINENO "No Developer ID found"

#######################################
# Set warning levels
#######################################

WARNING_FLAGS=""

case "${WARN_LEVEL:-}" in
    ""|0)
        ;;
    1)
        WARNING_FLAGS="-Wall -Wextra"
        ;;
    2)
        WARNING_FLAGS="-Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wsign-conversion"
        ;;
    *)
        fail 1 $LINENO "Invalid WARNING_LEVEL=${WARN_LEVEL}"
        ;;
esac

#######################################
# Append warning flags
#######################################

if [[ -n "$WARNING_FLAGS" ]]; then
    CFLAGS="$CFLAGS $WARNING_FLAGS"
    CXXFLAGS="$CXXFLAGS $WARNING_FLAGS"
    OBJCFLAGS="$OBJCFLAGS $WARNING_FLAGS"
    OBJCXXFLAGS="$OBJCXXFLAGS $WARNING_FLAGS"
fi

#######################################
# Export compiler flags
#######################################

# Security: allowlist-based compiler flag validation
# Only permit flags matching known-safe patterns; reject everything else.
for _flagvar in CFLAGS CXXFLAGS OBJCFLAGS OBJCXXFLAGS; do
    for _flag in ${(z)${(P)_flagvar}}; do
        case "$_flag" in
            # Linker/assembler/preprocessor pass-through is as dangerous as
            # -Xlinker and must be rejected before the -W* allowance below
            -Wl,*|-Wa,*|-Wp,*) fail 1 $LINENO "Pass-through flag not allowed in $_flagvar: $_flag" ;;
            # Warnings, optimization, debug, defines, standards, arch
            -W*|-O*|-g*|-D*|-std=*|-arch|-arch\ *|-m*|-pipe|-pthread) ;;
            # Feature flags (safe subset)
            -f[a-z]*)
                case "$_flag" in
                    -fplugin*) fail 1 $LINENO "Dangerous flag in $_flagvar: $_flag" ;;
                    *) ;;
                esac
                ;;
            # Include paths (but not -include with arbitrary files)
            -I*|-isystem|-isysroot|-iframework) ;;
            # Linker search paths
            -L*|-l*|-framework|-F*) ;;
            # Values that follow a flag (paths, names) — allow non-dash tokens
            [!/+-@]*) ;;
            # Absolute path arguments to allowlisted flags (e.g. -isysroot /path)
            /*) ;;
            # Explicitly dangerous: @file, -load, -B, -specs, -wrapper,
            # -x assembler, -include, -o, -Xlinker, --sysroot
            @*) fail 1 $LINENO "Response file not allowed in $_flagvar: $_flag" ;;
            *)  fail 1 $LINENO "Disallowed flag in $_flagvar: $_flag" ;;
        esac
    done
done

[[ -n "$CFLAGS" ]] && export CFLAGS
[[ -n "$CXXFLAGS" ]] && export CXXFLAGS
[[ -n "$OBJCFLAGS" ]] && export OBJCFLAGS
[[ -n "$OBJCXXFLAGS" ]] && export OBJCXXFLAGS

#######################################
# Dependencies
#######################################

install_deps() {
    if [[ "$UPDATE_DEPS" != "1" ]]; then
        return
    fi

    check_command brew
    brew update
    # Security: only upgrade required dependencies, not all installed packages
    brew upgrade "${BREW_DEPS[@]}"
    brew cleanup
    command -v rustup >/dev/null && rustup update || true
}

install_deps

#######################################
# Patch state setup
#######################################

# File to track applied patches
PATCH_STATE_FILE="$PATCHDIR/applied_patches"

#######################################
# Apply Patch (idempotent)
#######################################

apply_patches() {
    # Skip if disabled
    if [[ "${APPLY_PATCHES:-0}" != "1" ]]; then
        return
    fi

    # Skip if PATCHDIR missing or empty
    if [[ ! -d "$PATCHDIR" ]]; then
        echo "ℹ️  Patch directory not found – skipping patches"
        return
    fi

    # Must be initialized before the patch loop below: it is read after the
    # if/else even when no patches exist (nounset safety)
    local changed=0

    # Collect patches
    local patches
    patches=("$PATCHDIR"/*.patch(N))

    if (( ${#patches} == 0 )); then
        echo "ℹ️  No patches found – nothing to apply"
    else

    echo "----------------------------------------"
    echo "▶ Applying patches"

    touch "$PATCH_STATE_FILE"
    
    typeset -A applied
    local record

    # Load applied patches into memory
    while IFS= read -r record || [[ -n "$record" ]]; do
    record="${record//$'\r'/}"

    # Trim whitespace
    record="${record##[[:space:]]#}"
    record="${record%%[[:space:]]#}"

    # Remove ALL quotes, defensiv
    record="${record//\"/}"

    # Strict validation
    [[ "$record" == [A-Za-z0-9._-]##.patch:[0-9a-f](#c64) ]] || {
        echo "⚠️  Ignoring invalid patch state entry: $record"
        continue
    }

    # Note: subscript must be UNQUOTED – zsh treats subscript text as if it
    # were already double-quoted, so ["$record"] would embed literal quote
    # characters into the key and break every ${applied[$key]} lookup
    applied[$record]=1
done < "$PATCH_STATE_FILE"
    
# Detect deleted patches referenced in state
    local patch_name
    for record in "${(@k)applied[@]}"; do  
    record="${record//\"/}"
    patch_name="${record%%:*}"
    patch_path="${PATCHDIR}/${patch_name}"

    if [[ ! -f "$patch_path" ]]; then
        echo "⚠️  Patch state references missing patch: $patch_name"

            if [[ -t 0 ]]; then
                read "ans?Remove stale state entry? [y/N]: "
                if [[ "$ans" =~ ^[Yy]$ ]]; then
                    unset "applied[$record]"
                    # Rewrite the state file from the validated in-memory
                    # entries – a raw grep would miss lines that only became
                    # valid after quote/whitespace cleanup above
                    if (( ${#applied[@]} )); then
                        print -l -- "${(@k)applied}" > "$PATCH_STATE_FILE.tmp"
                    else
                        : > "$PATCH_STATE_FILE.tmp"
                    fi
                    mv "$PATCH_STATE_FILE.tmp" "$PATCH_STATE_FILE"
                    echo "✔ Removed stale patch state"
                else
                    fail 1 $LINENO "Stale patch state detected"
                fi
            else
                fail 1 $LINENO "Stale patch state detected (non-interactive)"
            fi
        fi
    done

    # Apply patches
    local patch checksum key

    cd "$ROOT" || fail 1 $LINENO "Directory $ROOT not found"

    for patch in "${patches[@]}"; do
    checksum=$(shasum -a 256 "$patch" | awk '{print $1}')
    key="$(basename "$patch"):$checksum"

    if [[ -n "${applied[$key]-}" ]]; then
        echo "✔ Patch already applied: $(basename "$patch")"
        continue
    fi

   # Security: copy first, then validate the copy to eliminate TOCTOU
    local _safe_patch
    _safe_patch=$(mktemp "${TMPDIR:-/tmp}/hb-patch.XXXXXX")
    _TMPFILES+=("$_safe_patch")
    cp "$patch" "$_safe_patch"
    chmod 0600 "$_safe_patch"

    # Check for path traversal (a ".." path component anywhere, with or
    # without a/ b/ prefixes) and absolute paths in +++/--- headers.
    # "/dev/null" is the legitimate header for file creation/deletion.
    if grep -qE '^(\+\+\+|\-\-\-) [^[:space:]]*\.\.(/|[[:space:]]|$)' "$_safe_patch" || \
       grep -E '^(\+\+\+|\-\-\-) /' "$_safe_patch" | grep -vE '^(\+\+\+|\-\-\-) /dev/null([[:space:]]|$)' | grep -q .; then
        echo "⚠️  Patch contains path traversal or absolute path — skipping: $(basename "$patch")"
        rm -f "$_safe_patch"
        continue
    fi

    if patch --dry-run --forward -p1 < "$_safe_patch" >/dev/null 2>&1; then
        echo "  → Applying $(basename "$patch")"
        if patch --forward --batch -p1 < "$_safe_patch"; then
            changed=1
        else
            echo "⚠️  Patch partially failed or conflicts detected: $(basename "$patch")"
            rm -f "$_safe_patch"
            continue   # do not record failed patches as applied
        fi
    elif patch --dry-run --reverse --force -p1 < "$_safe_patch" >/dev/null 2>&1; then
        # Applies cleanly in reverse → the patch is already in the source
        echo "✔ Patch already present in source: $(basename "$patch")"
    else
        echo "⚠️  Patch does not apply cleanly – skipping: $(basename "$patch")"
        rm -f "$_safe_patch"
        continue   # do not record; it will be retried on the next run
    fi
    rm -f "$_safe_patch"

    grep -qxF "$key" "$PATCH_STATE_FILE" || echo "$key" >> "$PATCH_STATE_FILE"
    applied[$key]=1
done
fi

    # Detect unpatched local modifications
    if (( changed == 0 )); then
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        if ! git diff --quiet; then
            echo "⚠️  Source tree contains unpatched local changes"

            if [[ ! -w "$PATCHDIR" ]]; then
                echo "⚠️  Patch directory not writable – cannot create patches"
            elif [[ -t 0 ]]; then
                read "ans?Create a new patch from these changes? [y/N]: "
                if [[ "$ans" =~ ^[Yy]$ ]]; then
                    local ts patchfile
                    ts=$(date '+%Y%m%d-%H%M%S')
                    patchfile="$PATCHDIR/local-$ts.patch"

                    git diff > "$patchfile"
                    echo "✔ Patch created: $(basename "$patchfile")"
                    echo "ℹ️  Patch will be applied on next run"
                fi
            else
                echo "ℹ️  Non-interactive mode – patch creation skipped"
            fi
        fi
    fi
fi

    # Summary
    if (( changed )); then
        echo "✔ Patches successfully applied"
    else
        echo "✔ All patches already applied"
    fi
}

#######################################
# Clean
#######################################

clean_build() {
    [[ "$BUILD_DIR" == "$ROOT"/build ]] || fail 1 $LINENO "Invalid build directory"
    # Security: validate DEV_DIR is a real absolute path, not a sensitive
    # location. zsh's ":A" modifier resolves symlinks like realpath(3) –
    # the realpath(1) binary does not exist before macOS 13.
    local _real_dev_dir
    _real_dev_dir="${DEV_DIR:A}"
    [[ -n "$_real_dev_dir" ]] || fail 1 $LINENO "Cannot resolve DEV_DIR path: $DEV_DIR"
    if [[ -L "$DEV_DIR" ]]; then
        fail 1 $LINENO "DEV_DIR is a symlink (not allowed): $DEV_DIR"
    fi
    case "$_real_dev_dir" in
        /|/System*|/usr*|/var*|/private*|/Applications|/Library)
            fail 1 $LINENO "DEV_DIR points to a protected system path: $_real_dev_dir"
            ;;
    esac
    [[ -d "$BUILD_DIR" ]] || { echo "ℹ️  Build directory does not exist – nothing to clean"; return; }
    rm -rf "$BUILD_DIR"
    rm -f "$ROOT/hbsign.log"
    rm -rf "$ROOT/macosx/DerivedData"
}

clean_build

#######################################
# Configure and build
#######################################

configure_handbrake() {
    cd "$ROOT" || fail 1 $LINENO "Directory $ROOT not found"

    JOBS=$(sysctl -n hw.perflevel0.logicalcpu 2>/dev/null || sysctl -n hw.ncpu)
    JOBS=${JOBS:-4}

echo "▶ ./configure options:"
echo "   --launch-jobs=$JOBS --launch $ADD_CONFIG_OPTS"
git diff --quiet || echo "⚠️  Building from modified sources"

# Security: validate ADD_CONFIG_OPTS — reject path-altering or shell-unsafe options
typeset -a CONFIG_OPTS
CONFIG_OPTS=(${(z)${ADD_CONFIG_OPTS:-}})
for _opt in "${CONFIG_OPTS[@]}"; do
    case "$_opt" in
        --prefix=*|--exec-prefix=*|--bindir=*|--sbindir=*|--libdir=*)
            fail 1 $LINENO "Path-altering configure option not allowed: $_opt" ;;
        *[';|&$\`']*)
            fail 1 $LINENO "Shell metacharacter in configure option: $_opt" ;;
    esac
done

./configure \
    --launch-jobs="$JOBS" \
    --launch \
    "${CONFIG_OPTS[@]}"
}

build_handbrake() {
    cd "$BUILD_DIR" || fail 1 $LINENO "Build directory not found"
    echo "▶ Running make build"

    # Output already reaches $LOGFILE through the global tee set up in
    # log_header (a second tee here would duplicate every log line)
    _ERR_TRAP_OFF=1
    set +e
    make build 2>&1
    local rc=$?
    set -e
    _ERR_TRAP_OFF=0

    if (( rc != 0 )); then
        echo
        echo "❌ Build failed during compilation"

        if [[ -s "${LOGFILE:-}" ]]; then
            echo "🔍 Last compiler errors:"
            grep -E "error:|fatal error:" "$LOGFILE" | tail -n 20 | sed 's/^/   /' || true
        fi

        fail "$rc" $LINENO "make build failed"
    fi

}

apply_patches
configure_handbrake
build_handbrake

#######################################
# Sign
#######################################

sign_handbrake() {
    echo "Signing the build"
    make sign ID="$SIGNINGHASH"
}

sign_handbrake

#######################################
# Notarization
#######################################
validate_notary_config() {
    if [[ "$NOTARY_ENABLE" != "1" ]]; then
    return
fi

    [[ -n "$NOTARY_USERNAME" ]] || fail 1 $LINENO "NOTARY_USERNAME required when NOTARY_ENABLE=1"
    [[ -n "$NOTARY_TEAMID"  ]] || fail 1 $LINENO "NOTARY_TEAMID required when NOTARY_ENABLE=1"
}

get_notary_password() {
    if [[ "$NOTARY_ENABLE" != "1" ]]; then
        return
    fi

    security find-generic-password \
        -a "$NOTARY_USERNAME" \
        -s "HandBrakeNotary" \
        -w 2>/dev/null
}

run_notarization() {
    if [[ "$NOTARY_ENABLE" != "1" ]]; then
        echo "ℹ️ Notarization disabled"
        return
    fi

    # "|| true" keeps a missing keychain item from killing the script via the
    # ERR trap before the explicit, actionable check below is reached
    NOTARY_PASSWORD="$(get_notary_password)" || true

    [[ -n "$NOTARY_PASSWORD" ]] || fail 1 $LINENO "Notary password not found in keychain"

    echo "🔐  Starting notarization"
    cd "$BUILD_DIR" || fail 1 $LINENO "Build directory not found"

    _ERR_TRAP_OFF=1
    set +e
    # Security: pass password via environment variable, not command-line argument
    PASSWORD="$NOTARY_PASSWORD" make notarize \
        USERNAME="$NOTARY_USERNAME" \
        TEAMID="$NOTARY_TEAMID"
    local NOTARY_RC=$?
    set -e
    _ERR_TRAP_OFF=0

    # Security: clear password from memory as soon as possible
    unset NOTARY_PASSWORD

    if (( NOTARY_RC != 0 )); then
        echo "❌  Notarization failed (exit code $NOTARY_RC)"
        echo
        echo "ℹ️  Last notarytool history (if available):"

        # Security: suppress apple-id from terminal/log output
        xcrun notarytool history \
            --apple-id "$NOTARY_USERNAME" \
            --team-id "$NOTARY_TEAMID" 2>/dev/null \
            | sed "s/$NOTARY_USERNAME/[REDACTED]/g" || true

        return "$NOTARY_RC"
    fi

    echo "✔ Notarization successful"
}
validate_notary_config
run_notarization

#######################################
# Install
#######################################

install_app() {
    [[ -x "$APP_BIN" ]] || fail 1 $LINENO "Application binary does not exist"
    [[ -d "$INSTALL_APP" ]] || echo "ℹ️ Target application does not yet exist"
    cd "$BUILD_DIR" || fail 1 $LINENO "Build directory not found"
    echo "The finished HandBrake build will now be installed in the Application folder"
    make install
}

install_app

#######################################
# Security checks
#######################################

verify_app() {
    codesign --verify --deep --strict --verbose=4 "$INSTALL_APP" \
        || fail $? $LINENO "Code signing verification failed"

    if [[ "$NOTARY_ENABLE" == "1" ]]; then
        spctl -a -vvv -t install "$INSTALL_APP" \
            || fail $? $LINENO "spctl assessment failed"

        stapler validate "$INSTALL_APP" \
            || fail $? $LINENO "stapler validation failed"
    else
        echo "ℹ️  Notary disabled: Skipping Gatekeeper & stapler checks"
    fi
}

verify_app

optional_checks() {
    command -v check-signature >/dev/null 2>&1 && check-signature "$INSTALL_APP" || true
    otool -hv "$INSTALL_APP/Contents/MacOS/HandBrake"
    otool -Iv "$INSTALL_APP/Contents/MacOS/HandBrake" | grep -i stack || true
}

optional_checks

#######################################
# Package creation (optional)
#######################################

create_pkg() {
    if [[ "$MAKE_INSTALLER" != "1" ]]; then
        echo "ℹ️  Package creation disabled"
        return
    fi

    echo "📦  Creating release artifacts"

    cd "$BUILD_DIR" || fail 1 $LINENO "Build directory not found"

    _ERR_TRAP_OFF=1
    set +e
    make pkg.create
    local PKG_RC=$?
    set -e
    _ERR_TRAP_OFF=0

    (( PKG_RC == 0 )) || fail "$PKG_RC" $LINENO "Package creation failed"

    # (N) null-glob qualifiers: an unmatched bare glob is a hard zsh error
    # that would abort the whole script after a successful build
    local _artifacts _checksum_files
    _artifacts=(pkg/*.dmg(N) pkg/*.tar.bz2(N) pkg/*.xml(N))
    _checksum_files=(pkg/*.dmg(N) pkg/*.tar.bz2(N))

    if (( ${#_artifacts[@]} == 0 )); then
        fail 1 $LINENO "make pkg.create succeeded but produced no artifacts in pkg/"
    fi

    echo "✔ Release artifacts created:"
    ls -lh -- "${(@)_artifacts}" | sed 's/^/   /'

    echo "✔ Package created"
    if (( ${#_checksum_files[@]} )); then
        echo "🔑  SHA-256 checksums:"
        (
            cd pkg || exit 1
            shasum -a 256 -- "${(@)_checksum_files#pkg/}"
        )
    fi
}

#######################################
# Collect compiler warnings
#######################################

collect_warnings() {
    if [[ "$WARN_LOG" != "1" ]]; then
        return
    fi

    if [[ ! -f "${LOGFILE:-}" ]]; then
        echo "ℹ️  No build log available (WARN_LOG requires ENABLE_LOG=1) – skipping warning collection"
        return
    fi

    echo "▶ Collecting compiler warnings"

    : > "$WARNLOG"

    sed -E 's/\x1B\[[0-9;]*[mK]//g' "$LOGFILE" \
    | awk '
    BEGIN {
    warn = 0
}

# BSD awk has no IGNORECASE – match against a lowercased copy instead
{ low = tolower($0) }

low ~ /(^|[[:space:]])warning:/ {
    warn = 1
    sub(/^[[:space:]]*/, "  : ")
    print
    next
}

warn && low ~ /(^|[[:space:]])note:/ {
    sub(/^[[:space:]]*/, "  : ")
    print
    next
}

/^[^[:space:]]/ {
    warn = 0
}
' >> "$WARNLOG"

    if [[ -s "$WARNLOG" ]]; then
        echo "⚠️  Compiler warnings found: $(wc -l < "$WARNLOG")"
        echo "   → $WARNLOG"
    else
        rm -f "$WARNLOG"
        echo "✔ No compiler warnings found"
    fi
}

#######################################
# Functional test
#######################################

functional_test() {
    if [[ "${FUNCTIONAL_TEST:-0}" != "1" ]]; then
        echo "ℹ️  Functional tests disabled – skipping"
        return
    fi

    # Security: SCRIPT_DIR was resolved via ${0:A:h} at top level (symlink-safe);
    # $0 inside a function would be the function name, not the script path
    local _hb_test="$SCRIPT_DIR/hb-test"
    if [[ ! -x "$_hb_test" ]]; then
        fail 1 $LINENO "Functional test script not found: $_hb_test"
    fi

    # The test harness tools are not installed by the build itself
    local _tool
    for _tool in ffprobe jq mediainfo; do
        command -v "$_tool" >/dev/null 2>&1 \
            || fail 1 $LINENO "Functional tests require '$_tool' (install via: brew install ffmpeg jq mediainfo)"
    done

    # Prefer the freshly built HandBrakeCLI over whatever happens to be on PATH
    local _cli
    for _cli in "$BUILD_DIR/HandBrakeCLI" "$BUILD_DIR/xroot/HandBrakeCLI"; do
        if [[ -x "$_cli" ]]; then
            export HB_CLI="$_cli"
            echo "ℹ️  Testing freshly built CLI: $_cli"
            break
        fi
    done
    if [[ -z "${HB_CLI:-}" ]]; then
        echo "⚠️  Freshly built HandBrakeCLI not found – testing HandBrakeCLI from PATH"
    fi

    echo "----------------------------------------"
    echo "▶ Running functional tests"

    if ! "$_hb_test"; then
        fail 1 $LINENO "Functional tests failed"
    fi

    echo "✔ Functional tests passed"
}

collect_warnings
create_pkg
functional_test

