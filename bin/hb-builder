# Success
#######################################

command -v afplay >/dev/null && afplay /System/Applications/Music.app/Contents/Resources/complete.aif || true
[[ -x "$TERMINAL_NOTIFIER" ]] && "$TERMINAL_NOTIFIER" \
    -title "HandBrake" \
    -message "$(date '+%d-%m-%Y %H:%M'): Build successful" || true

exit 0